\uc0\u1054 \uc0\u1070 \uc0\u1051  \uc0\u1050 \uc0\u1072 \uc0\u1079 \uc0\u1072 \uc0\u1093 \uc0\u1089 \uc0\u1090 \uc0\u1072 \uc0\u1085 \uc0\u1089 \uc0\u1082 \uc0\u1072 \uc0\u1103  \uc0\u1072 \uc0\u1089 \uc0\u1089 \uc0\u1086 \uc0\u1094 \uc0\u1080 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1103  \uc0\u1080 \uc0\u1085 \uc0\u1085 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1086 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1093  \uc0\u1087 \uc0\u1088 \uc0\u1077 \uc0\u1076 \uc0\u1087 \uc0\u1088 \uc0\u1080 \uc0\u1103 \uc0\u1090 \uc0\u1080 \uc0\u1081 
