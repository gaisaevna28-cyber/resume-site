\trowd\cellx9638\pard\intbl\itap1\sl260{\fs18 \uc0\u1047 \uc0\u1076 \uc0\u1088 \uc0\u1072 \uc0\u1074 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1091 \uc0\u1081 \uc0\u1090 \uc0\u1077 !{\line}{\line}\uc0\u1052 \uc0\u1077 \uc0\u1085 \uc0\u1103  \uc0\u1079 \uc0\u1072 \uc0\u1080 \uc0\u1085 \uc0\u1090 \uc0\u1077 \uc0\u1088 \uc0\u1077 \uc0\u1089 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1083 \uc0\u1072  \uc0\u1042 \uc0\u1072 \uc0\u1096 \uc0\u1072  \uc0\u1074 \uc0\u1072 \uc0\u1082 \uc0\u1072 \uc0\u1085 \uc0\u1089 \uc0\u1080 \uc0\u1103 . \uc0\u1054 \uc0\u1073 \uc0\u1083 \uc0\u1072 \uc0\u1076 \uc0\u1072 \uc0\u1102  \uc0\u1086 \uc0\u1087 \uc0\u1099 \uc0\u1090 \uc0\u1086 \uc0\u1084  \uc0\u1074  \uc0\u1088 \uc0\u1086 \uc0\u1083 \uc0\u1080  BA/SA \uc0\u1073 \uc0\u1086 \uc0\u1083 \uc0\u1077 \uc0\u1077  8 \uc0\u1083 \uc0\u1077 \uc0\u1090  \uc0\u1074  \uc0\u1089 \uc0\u1092 \uc0\u1077 \uc0\u1088 \uc0\u1072 \uc0\u1093  GovTech \uc0\u1080  E-commerce.{\line}{\line}\uc0\u1042  \uc0\u1088 \uc0\u1086 \uc0\u1083 \uc0\u1080  \uc0\u1072 \uc0\u1085 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1090 \uc0\u1080 \uc0\u1082 \uc0\u1072  \uc0\u1103  \uc0\u1079 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1084 \uc0\u1072 \uc0\u1083 \uc0\u1072 \uc0\u1089 \uc0\u1100  \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1085 \uc0\u1099 \uc0\u1084  \uc0\u1094 \uc0\u1080 \uc0\u1082 \uc0\u1083 \uc0\u1086 \uc0\u1084  \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1099  \uc0\u1089  \uc0\u1090 \uc0\u1088 \uc0\u1077 \uc0\u1073 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1103 \uc0\u1084 \uc0\u1080 : \uc0\u1086 \uc0\u1090  \uc0\u1089 \uc0\u1073 \uc0\u1086 \uc0\u1088 \uc0\u1072  \uc0\u1080  \uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1084 \uc0\u1091 \uc0\u1085 \uc0\u1080 \uc0\u1082 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1080  \uc0\u1089 \uc0\u1086  \uc0\u1089 \uc0\u1090 \uc0\u1077 \uc0\u1081 \uc0\u1082 \uc0\u1093 \uc0\u1086 \uc0\u1083 \uc0\u1076 \uc0\u1077 \uc0\u1088 \uc0\u1072 \uc0\u1084 \uc0\u1080  \uc0\u1076 \uc0\u1086  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1103  UI/UX (Figma, Miro), \uc0\u1089 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1072 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1058 \uc0\u1047 , \uc0\u1086 \uc0\u1087 \uc0\u1080 \uc0\u1089 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1084 \uc0\u1080 \uc0\u1082 \uc0\u1088 \uc0\u1086 \uc0\u1089 \uc0\u1077 \uc0\u1088 \uc0\u1074 \uc0\u1080 \uc0\u1089 \uc0\u1086 \uc0\u1074 , Use Cases, User Stories \uc0\u1080  UML-\uc0\u1076 \uc0\u1080 \uc0\u1072 \uc0\u1075 \uc0\u1088 \uc0\u1072 \uc0\u1084 \uc0\u1084  (Sequence, Activity), \uc0\u1090 \uc0\u1077 \uc0\u1089 \uc0\u1090 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1103  API (Postman, SoapUI) \uc0\u1080  \uc0\u1072 \uc0\u1085 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1079 \uc0\u1072  \uc0\u1083 \uc0\u1086 \uc0\u1075 \uc0\u1086 \uc0\u1074  (Kibana). \uc0\u1056 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1072 \uc0\u1083 \uc0\u1072  \uc0\u1089  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1072 \uc0\u1084 \uc0\u1080  \uc0\u1074  \uc0\u1089 \uc0\u1092 \uc0\u1077 \uc0\u1088 \uc0\u1072 \uc0\u1093  \uc0\u1075 \uc0\u1086 \uc0\u1089 \uc0\u1091 \uc0\u1076 \uc0\u1072 \uc0\u1088 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1077 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1093  \uc0\u1089 \uc0\u1077 \uc0\u1088 \uc0\u1074 \uc0\u1080 \uc0\u1089 \uc0\u1086 \uc0\u1074  \uc0\u1080  e-commerce \uc0\u1085 \uc0\u1072  \uc0\u1074 \uc0\u1077 \uc0\u1073 - \uc0\u1080  \uc0\u1084 \uc0\u1086 \uc0\u1073 \uc0\u1080 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1099 \uc0\u1093  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1076 \uc0\u1091 \uc0\u1082 \uc0\u1090 \uc0\u1072 \uc0\u1093 . \uc0\u1048 \uc0\u1084 \uc0\u1077 \uc0\u1102  \uc0\u1086 \uc0\u1087 \uc0\u1099 \uc0\u1090  \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1099  \uc0\u1089  \uc0\u1075 \uc0\u1086 \uc0\u1089 \uc0\u1091 \uc0\u1076 \uc0\u1072 \uc0\u1088 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1077 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1084 \uc0\u1080  \uc0\u1089 \uc0\u1080 \uc0\u1089 \uc0\u1090 \uc0\u1077 \uc0\u1084 \uc0\u1072 \uc0\u1084 \uc0\u1080  \uc0\u1080  \uc0\u1087 \uc0\u1083 \uc0\u1072 \uc0\u1090 \uc0\u1092 \uc0\u1086 \uc0\u1088 \uc0\u1084 \uc0\u1072 \uc0\u1084 \uc0\u1080 . \uc0\u1055 \uc0\u1088 \uc0\u1086 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1083 \uc0\u1072  \uc0\u1080 \uc0\u1085 \uc0\u1090 \uc0\u1077 \uc0\u1075 \uc0\u1088 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1086 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1077  \uc0\u1080 \uc0\u1085 \uc0\u1090 \uc0\u1077 \uc0\u1088 \uc0\u1092 \uc0\u1077 \uc0\u1081 \uc0\u1089 \uc0\u1099  (REST, SOAP) \uc0\u1080  \uc0\u1091 \uc0\u1095 \uc0\u1072 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1083 \uc0\u1072  \uc0\u1074  \uc0\u1092 \uc0\u1086 \uc0\u1088 \uc0\u1084 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1080  \uc0\u1086 \uc0\u1090 \uc0\u1082 \uc0\u1088 \uc0\u1099 \uc0\u1090 \uc0\u1099 \uc0\u1093  API \uc0\u1075 \uc0\u1086 \uc0\u1089 \uc0\u1091 \uc0\u1076 \uc0\u1072 \uc0\u1088 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1077 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1093  \uc0\u1091 \uc0\u1089 \uc0\u1083 \uc0\u1091 \uc0\u1075  \uc0\u1076 \uc0\u1083 \uc0\u1103  \uc0\u1087 \uc0\u1086 \uc0\u1076 \uc0\u1082 \uc0\u1083 \uc0\u1102 \uc0\u1095 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1089 \uc0\u1090 \uc0\u1086 \uc0\u1088 \uc0\u1086 \uc0\u1085 \uc0\u1085 \uc0\u1080 \uc0\u1093  \uc0\u1086 \uc0\u1088 \uc0\u1075 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1079 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1081 .{\line}{\line}\uc0\u1053 \uc0\u1072  \uc0\u1076 \uc0\u1072 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1081  \uc0\u1084 \uc0\u1086 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1090  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1093 \uc0\u1086 \uc0\u1078 \uc0\u1091  \uc0\u1082 \uc0\u1091 \uc0\u1088 \uc0\u1089 \uc0\u1099  \uc0\u1040 \uc0\u1088 \uc0\u1093 \uc0\u1080 \uc0\u1090 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1091 \uc0\u1088 \uc0\u1072  AI -\uc0\u1087 \uc0\u1088 \uc0\u1080 \uc0\u1083 \uc0\u1086 \uc0\u1078 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1081 .{\line}{\line}\uc0\u1041 \uc0\u1091 \uc0\u1076 \uc0\u1091  \uc0\u1088 \uc0\u1072 \uc0\u1076 \uc0\u1072  \uc0\u1086 \uc0\u1073 \uc0\u1089 \uc0\u1091 \uc0\u1076 \uc0\u1080 \uc0\u1090 \uc0\u1100  \uc0\u1079 \uc0\u1072 \uc0\u1076 \uc0\u1072 \uc0\u1095 \uc0\u1080  \uc0\u1074 \uc0\u1072 \uc0\u1082 \uc0\u1072 \uc0\u1085 \uc0\u1089 \uc0\u1080 \uc0\u1080  \uc0\u1085 \uc0\u1072  \uc0\u1089 \uc0\u1086 \uc0\u1073 \uc0\u1077 \uc0\u1089 \uc0\u1077 \uc0\u1076 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1080 .{\line}{\line}\uc0\u1057  \uc0\u1091 \uc0\u1074 \uc0\u1072 \uc0\u1078 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077 \uc0\u1084 ,{\line}{\line}\uc0\u1043 \uc0\u1091 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1091 \uc0\u1088  \uc0\u1045 \uc0\u1088 \uc0\u1084 \uc0\u1072 \uc0\u1075 \uc0\u1072 \uc0\u1084 \uc0\u1073 \uc0\u1077 \uc0\u1090 \uc0\u1086 \uc0\u1074 \uc0\u1072 ,{\line}+7 (775) 915-49-28{\line}g.yermagambetova@gmail.com}\cell\row
