\uc0\u171 \uc0\u1057 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1084 \uc0\u1076 \uc0\u1080  \uc0\u1050 \uc0\u1091 \uc0\u1088 \uc0\u1099 \uc0\u1083 \uc0\u1099 \uc0\u1089 \uc0\u187 
