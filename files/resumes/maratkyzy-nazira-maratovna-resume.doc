\pard\intbl\itap1\sl280\sb60\sa60{\fs24 \uc0\u1040 \uc0\u1085 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1090 \uc0\u1080 \uc0\u1082  \uc0\u1087 \uc0\u1086  \uc0\u1087 \uc0\u1083 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1102 \par}

\pard\intbl\itap1\sl260\sa60{\fs18 \uc0\u1071 \uc0\u1085 \uc0\u1074 \uc0\u1072 \uc0\u1088 \uc0\u1100  -\uc0\u1052 \uc0\u1072 \uc0\u1081  2018 \uc0\u8211  2023 \uc0\u1075 \uc0\u1075 . \uc0\u1040 \uc0\u1085 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1090 \uc0\u1080 \uc0\u1082  \uc0\u1087 \uc0\u1086  \uc0\u1087 \uc0\u1083 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1102  C&P (\uc0\u1082 \uc0\u1086 \uc0\u1085 \uc0\u1090 \uc0\u1088 \uc0\u1072 \uc0\u1082 \uc0\u1090 \uc0\u1086 \uc0\u1074  \uc0\u1080  \uc0\u1079 \uc0\u1072 \uc0\u1082 \uc0\u1091 \uc0\u1087 \uc0\u1086 \uc0\u1082 ), \uc0\u1079 \uc0\u1072 \uc0\u1074 \uc0\u1077 \uc0\u1088 \uc0\u1096 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1102  \uc0\u1089 \uc0\u1080 \uc0\u1089 \uc0\u1090 \uc0\u1077 \uc0\u1084  \uc0\u1080  IOCC(\uc0\u1048 \uc0\u1085 \uc0\u1090 \uc0\u1077 \uc0\u1075 \uc0\u1088 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1081  \uc0\u1094 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1088  \uc0\u1091 \uc0\u1087 \uc0\u1088 \uc0\u1072 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1086 \uc0\u1087 \uc0\u1077 \uc0\u1088 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1103 \uc0\u1084 \uc0\u1080 ) \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1072  FGP/WPMP.{\line}Planning / Planning Data Analyst \uc0\u1089  \uc0\u1086 \uc0\u1087 \uc0\u1099 \uc0\u1090 \uc0\u1086 \uc0\u1084  \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1099  \uc0\u1074  \uc0\u1085 \uc0\u1077 \uc0\u1092 \uc0\u1090 \uc0\u1077 \uc0\u1075 \uc0\u1072 \uc0\u1079 \uc0\u1086 \uc0\u1074 \uc0\u1099 \uc0\u1093  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1072 \uc0\u1093  \uc0\u1080  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1085 \uc0\u1086 \uc0\u1084  \uc0\u1087 \uc0\u1083 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1080 . {\line}\uc0\u1054 \uc0\u1087 \uc0\u1099 \uc0\u1090  \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1099  \uc0\u1089  Primavera P6, \uc0\u1087 \uc0\u1083 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1077 \uc0\u1084  \uc0\u1080  \uc0\u1082 \uc0\u1086 \uc0\u1085 \uc0\u1090 \uc0\u1088 \uc0\u1086 \uc0\u1083 \uc0\u1077 \uc0\u1084  \uc0\u1074 \uc0\u1099 \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1085 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 , \uc0\u1087 \uc0\u1086 \uc0\u1076 \uc0\u1075 \uc0\u1086 \uc0\u1090 \uc0\u1086 \uc0\u1074 \uc0\u1082 \uc0\u1086 \uc0\u1081  \uc0\u1086 \uc0\u1090 \uc0\u1095 \uc0\u1077 \uc0\u1090 \uc0\u1085 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1080 , \uc0\u1072 \uc0\u1085 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1079 \uc0\u1086 \uc0\u1084  \uc0\u1076 \uc0\u1072 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1093  \uc0\u1080  \uc0\u1074 \uc0\u1079 \uc0\u1072 \uc0\u1080 \uc0\u1084 \uc0\u1086 \uc0\u1076 \uc0\u1077 \uc0\u1081 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1080 \uc0\u1077 \uc0\u1084  \uc0\u1089  \uc0\u1088 \uc0\u1072 \uc0\u1079 \uc0\u1083 \uc0\u1080 \uc0\u1095 \uc0\u1085 \uc0\u1099 \uc0\u1084 \uc0\u1080  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1085 \uc0\u1099 \uc0\u1084 \uc0\u1080  \uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1072 \uc0\u1085 \uc0\u1076 \uc0\u1072 \uc0\u1084 \uc0\u1080 .{\line}\uc0\u1048 \uc0\u1084 \uc0\u1077 \uc0\u1102  \uc0\u1086 \uc0\u1087 \uc0\u1099 \uc0\u1090  \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1099  \uc0\u1089  \uc0\u1076 \uc0\u1072 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1084 \uc0\u1080  \uc0\u1080  \uc0\u1086 \uc0\u1090 \uc0\u1095 \uc0\u1077 \uc0\u1090 \uc0\u1085 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1100 \uc0\u1102 , \uc0\u1074 \uc0\u1082 \uc0\u1083 \uc0\u1102 \uc0\u1095 \uc0\u1072 \uc0\u1103  SQL, Power BI  \uc0\u1072  \uc0\u1090 \uc0\u1072 \uc0\u1082 \uc0\u1078 \uc0\u1077  \uc0\u1089  Excel \uc0\u1080  Primavera P6. \uc0\u1059 \uc0\u1084 \uc0\u1077 \uc0\u1102  \uc0\u1072 \uc0\u1085 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1079 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1090 \uc0\u1100  \uc0\u1076 \uc0\u1072 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1077 , \uc0\u1086 \uc0\u1090 \uc0\u1089 \uc0\u1083 \uc0\u1077 \uc0\u1078 \uc0\u1080 \uc0\u1074 \uc0\u1072 \uc0\u1090 \uc0\u1100  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1075 \uc0\u1088 \uc0\u1077 \uc0\u1089 \uc0\u1089  \uc0\u1086 \uc0\u1090 \uc0\u1085 \uc0\u1086 \uc0\u1089 \uc0\u1080 \uc0\u1090 \uc0\u1077 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1086  \uc0\u1087 \uc0\u1083 \uc0\u1072 \uc0\u1085 \uc0\u1072 , \uc0\u1074 \uc0\u1099 \uc0\u1103 \uc0\u1074 \uc0\u1083 \uc0\u1103 \uc0\u1090 \uc0\u1100  \uc0\u1086 \uc0\u1090 \uc0\u1082 \uc0\u1083 \uc0\u1086 \uc0\u1085 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1080  \uc0\u1087 \uc0\u1086 \uc0\u1076 \uc0\u1076 \uc0\u1077 \uc0\u1088 \uc0\u1078 \uc0\u1080 \uc0\u1074 \uc0\u1072 \uc0\u1090 \uc0\u1100  \uc0\u1087 \uc0\u1086 \uc0\u1076 \uc0\u1075 \uc0\u1086 \uc0\u1090 \uc0\u1086 \uc0\u1074 \uc0\u1082 \uc0\u1091  \uc0\u1087 \uc0\u1083 \uc0\u1072 \uc0\u1085 \uc0\u1086 \uc0\u1074  \uc0\u1080  \uc0\u1086 \uc0\u1090 \uc0\u1095 \uc0\u1077 \uc0\u1090 \uc0\u1086 \uc0\u1074 .{\line}- \uc0\u1054 \uc0\u1082 \uc0\u1072 \uc0\u1079 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1087 \uc0\u1086 \uc0\u1076 \uc0\u1076 \uc0\u1077 \uc0\u1088 \uc0\u1078 \uc0\u1082 \uc0\u1080  \uc0\u1074 \uc0\u1077 \uc0\u1076 \uc0\u1091 \uc0\u1097 \uc0\u1077 \uc0\u1084 \uc0\u1091  \uc0\u1087 \uc0\u1083 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1097 \uc0\u1080 \uc0\u1082 \uc0\u1091  \uc0\u1087 \uc0\u1086  \uc0\u1074 \uc0\u1086 \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1089 \uc0\u1072 \uc0\u1084  \uc0\u1087 \uc0\u1083 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1072  \uc0\u1076 \uc0\u1083 \uc0\u1103  \uc0\u1086 \uc0\u1073 \uc0\u1077 \uc0\u1089 \uc0\u1087 \uc0\u1077 \uc0\u1095 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1089 \uc0\u1074 \uc0\u1086 \uc0\u1077 \uc0\u1074 \uc0\u1088 \uc0\u1077 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1085 \uc0\u1086 \uc0\u1081  \uc0\u1080  \uc0\u1090 \uc0\u1086 \uc0\u1095 \uc0\u1085 \uc0\u1086 \uc0\u1081  \uc0\u1087 \uc0\u1086 \uc0\u1076 \uc0\u1075 \uc0\u1086 \uc0\u1090 \uc0\u1086 \uc0\u1074 \uc0\u1082 \uc0\u1080  \uc0\u1086 \uc0\u1090 \uc0\u1095 \uc0\u1077 \uc0\u1090 \uc0\u1085 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1080 , \uc0\u1089 \uc0\u1086 \uc0\u1079 \uc0\u1076 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1085 \uc0\u1086 \uc0\u1074 \uc0\u1099 \uc0\u1093  \uc0\u1075 \uc0\u1088 \uc0\u1072 \uc0\u1092 \uc0\u1080 \uc0\u1082 \uc0\u1086 \uc0\u1074  \uc0\u1074  P6 \uc0\u1080  \uc0\u1072 \uc0\u1082 \uc0\u1090 \uc0\u1091 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1079 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1080  \uc0\u1089 \uc0\u1091 \uc0\u1097 \uc0\u1077 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1091 \uc0\u1102 \uc0\u1097 \uc0\u1080 \uc0\u1093 .{\line}- \uc0\u1057 \uc0\u1086 \uc0\u1076 \uc0\u1077 \uc0\u1081 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1080 \uc0\u1077  \uc0\u1074 \uc0\u1086  \uc0\u1074 \uc0\u1085 \uc0\u1077 \uc0\u1076 \uc0\u1088 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1080 , \uc0\u1072 \uc0\u1076 \uc0\u1084 \uc0\u1080 \uc0\u1085 \uc0\u1080 \uc0\u1089 \uc0\u1090 \uc0\u1088 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1080  \uc0\u1080  \uc0\u1087 \uc0\u1086 \uc0\u1076 \uc0\u1076 \uc0\u1077 \uc0\u1088 \uc0\u1078 \uc0\u1082 \uc0\u1077  \uc0\u1089 \uc0\u1080 \uc0\u1089 \uc0\u1090 \uc0\u1077 \uc0\u1084  \uc0\u1080  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1094 \uc0\u1077 \uc0\u1076 \uc0\u1091 \uc0\u1088  \uc0\u1082 \uc0\u1086 \uc0\u1085 \uc0\u1090 \uc0\u1088 \uc0\u1086 \uc0\u1083 \uc0\u1103  \uc0\u1075 \uc0\u1088 \uc0\u1072 \uc0\u1092 \uc0\u1080 \uc0\u1082 \uc0\u1086 \uc0\u1074  \uc0\u1076 \uc0\u1083 \uc0\u1103  \uc0\u1086 \uc0\u1090 \uc0\u1089 \uc0\u1083 \uc0\u1077 \uc0\u1078 \uc0\u1080 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1087 \uc0\u1083 \uc0\u1072 \uc0\u1085 \uc0\u1086 \uc0\u1074  \uc0\u1080  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1075 \uc0\u1085 \uc0\u1086 \uc0\u1079 \uc0\u1086 \uc0\u1074  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1072 .{\line}- \uc0\u1042 \uc0\u1077 \uc0\u1076 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1080  \uc0\u1072 \uc0\u1082 \uc0\u1090 \uc0\u1091 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1079 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1103  \uc0\u1086 \uc0\u1073 \uc0\u1097 \uc0\u1077 \uc0\u1075 \uc0\u1086  \uc0\u1089 \uc0\u1090 \uc0\u1088 \uc0\u1086 \uc0\u1080 \uc0\u1090 \uc0\u1077 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1086 \uc0\u1075 \uc0\u1086  \uc0\u1087 \uc0\u1083 \uc0\u1072 \uc0\u1085 \uc0\u1072  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1072  \uc0\u1074  \uc0\u1089 \uc0\u1086 \uc0\u1086 \uc0\u1090 \uc0\u1074 \uc0\u1077 \uc0\u1090 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1080 \uc0\u1080  \uc0\u1089  \uc0\u1091 \uc0\u1082 \uc0\u1072 \uc0\u1079 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1103 \uc0\u1084 \uc0\u1080  \uc0\u1087 \uc0\u1083 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1097 \uc0\u1080 \uc0\u1082 \uc0\u1072  \uc0\u1087 \uc0\u1083 \uc0\u1086 \uc0\u1097 \uc0\u1072 \uc0\u1076 \uc0\u1082 \uc0\u1080 .{\line}- \uc0\u1054 \uc0\u1094 \uc0\u1077 \uc0\u1085 \uc0\u1082 \uc0\u1072  \uc0\u1090 \uc0\u1077 \uc0\u1085 \uc0\u1076 \uc0\u1077 \uc0\u1085 \uc0\u1094 \uc0\u1080 \uc0\u1081  \uc0\u1074 \uc0\u1099 \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1085 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1075 \uc0\u1088 \uc0\u1072 \uc0\u1092 \uc0\u1080 \uc0\u1082 \uc0\u1072  \uc0\u1080  \uc0\u1082 \uc0\u1086 \uc0\u1085 \uc0\u1090 \uc0\u1088 \uc0\u1086 \uc0\u1083 \uc0\u1100  \uc0\u1082 \uc0\u1086 \uc0\u1088 \uc0\u1088 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1085 \uc0\u1086 \uc0\u1075 \uc0\u1086  \uc0\u1086 \uc0\u1090 \uc0\u1088 \uc0\u1072 \uc0\u1078 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1076 \uc0\u1072 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1093  \uc0\u1090 \uc0\u1077 \uc0\u1085 \uc0\u1076 \uc0\u1077 \uc0\u1085 \uc0\u1094 \uc0\u1080 \uc0\u1081  \uc0\u1087 \uc0\u1086 \uc0\u1076 \uc0\u1088 \uc0\u1103 \uc0\u1076 \uc0\u1095 \uc0\u1080 \uc0\u1082 \uc0\u1086 \uc0\u1084  \uc0\u1074  \uc0\u1087 \uc0\u1077 \uc0\u1088 \uc0\u1080 \uc0\u1086 \uc0\u1076 \uc0\u1080 \uc0\u1095 \uc0\u1077 \uc0\u1089 \uc0\u1082 \uc0\u1080 \uc0\u1093  \uc0\u1086 \uc0\u1090 \uc0\u1095 \uc0\u1077 \uc0\u1090 \uc0\u1072 \uc0\u1093 .{\line}- \uc0\u1040 \uc0\u1085 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1079  \uc0\u1086 \uc0\u1090 \uc0\u1095 \uc0\u1077 \uc0\u1090 \uc0\u1086 \uc0\u1074  \uc0\u1087 \uc0\u1086 \uc0\u1076 \uc0\u1088 \uc0\u1103 \uc0\u1076 \uc0\u1095 \uc0\u1080 \uc0\u1082 \uc0\u1072 , \uc0\u1086 \uc0\u1073 \uc0\u1077 \uc0\u1089 \uc0\u1087 \uc0\u1077 \uc0\u1095 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1076 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1086 \uc0\u1074 \uc0\u1077 \uc0\u1088 \uc0\u1085 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1080  \uc0\u1086 \uc0\u1090 \uc0\u1095 \uc0\u1077 \uc0\u1090 \uc0\u1085 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1080  \uc0\u1086  \uc0\u1093 \uc0\u1086 \uc0\u1076 \uc0\u1077  \uc0\u1074 \uc0\u1099 \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1085 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090  \uc0\u1080  \uc0\u1074 \uc0\u1099 \uc0\u1076 \uc0\u1077 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1079 \uc0\u1085 \uc0\u1072 \uc0\u1095 \uc0\u1080 \uc0\u1084 \uc0\u1099 \uc0\u1093  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1073 \uc0\u1083 \uc0\u1077 \uc0\u1084 /\uc0\u1088 \uc0\u1080 \uc0\u1089 \uc0\u1082 \uc0\u1086 \uc0\u1074 .{\line}- \uc0\u1055 \uc0\u1086 \uc0\u1076 \uc0\u1075 \uc0\u1086 \uc0\u1090 \uc0\u1086 \uc0\u1074 \uc0\u1082 \uc0\u1072  \uc0\u1080  \uc0\u1074 \uc0\u1099 \uc0\u1087 \uc0\u1091 \uc0\u1089 \uc0\u1082  \uc0\u1086 \uc0\u1090 \uc0\u1095 \uc0\u1077 \uc0\u1090 \uc0\u1086 \uc0\u1074  \uc0\u1080  \uc0\u1076 \uc0\u1072 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1093  \uc0\u1087 \uc0\u1086  \uc0\u1079 \uc0\u1072 \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1089 \uc0\u1091 .{\line}- \uc0\u1054 \uc0\u1073 \uc0\u1085 \uc0\u1086 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1077 \uc0\u1078 \uc0\u1077 \uc0\u1085 \uc0\u1077 \uc0\u1076 \uc0\u1077 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1099 \uc0\u1093  \uc0\u1080  \uc0\u1077 \uc0\u1078 \uc0\u1077 \uc0\u1084 \uc0\u1077 \uc0\u1089 \uc0\u1103 \uc0\u1095 \uc0\u1085 \uc0\u1099 \uc0\u1093  \uc0\u1086 \uc0\u1090 \uc0\u1095 \uc0\u1077 \uc0\u1090 \uc0\u1086 \uc0\u1074  \uc0\u1080  \uc0\u1076 \uc0\u1072 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1093  \uc0\u1087 \uc0\u1086  \uc0\u1084 \uc0\u1077 \uc0\u1088 \uc0\u1077  \uc0\u1085 \uc0\u1077 \uc0\u1086 \uc0\u1073 \uc0\u1093 \uc0\u1086 \uc0\u1076 \uc0\u1080 \uc0\u1084 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1080 .{\line}- \uc0\u1055 \uc0\u1086 \uc0\u1076 \uc0\u1075 \uc0\u1086 \uc0\u1090 \uc0\u1086 \uc0\u1074 \uc0\u1082 \uc0\u1072  \uc0\u1076 \uc0\u1080 \uc0\u1072 \uc0\u1075 \uc0\u1088 \uc0\u1072 \uc0\u1084 \uc0\u1084  \uc0\u1086 \uc0\u1073 \uc0\u1098 \uc0\u1077 \uc0\u1084 \uc0\u1086 \uc0\u1074  \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 , \uc0\u1082 \uc0\u1086 \uc0\u1090 \uc0\u1086 \uc0\u1088 \uc0\u1099 \uc0\u1081  \uc0\u1085 \uc0\u1072 \uc0\u1075 \uc0\u1083 \uc0\u1103 \uc0\u1076 \uc0\u1085 \uc0\u1086  \uc0\u1086 \uc0\u1090 \uc0\u1086 \uc0\u1073 \uc0\u1088 \uc0\u1072 \uc0\u1078 \uc0\u1072 \uc0\u1077 \uc0\u1090  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1075 \uc0\u1088 \uc0\u1077 \uc0\u1089 \uc0\u1089  \uc0\u1087 \uc0\u1086  \uc0\u1087 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1072 \uc0\u1074 \uc0\u1082 \uc0\u1072 \uc0\u1084  \uc0\u1080 \uc0\u1083 \uc0\u1080  \uc0\u1084 \uc0\u1086 \uc0\u1085 \uc0\u1090 \uc0\u1072 \uc0\u1078 \uc0\u1091  \uc0\u1086 \uc0\u1089 \uc0\u1085 \uc0\u1086 \uc0\u1074 \uc0\u1085 \uc0\u1099 \uc0\u1093  \uc0\u1088 \uc0\u1077 \uc0\u1089 \uc0\u1091 \uc0\u1088 \uc0\u1089 \uc0\u1086 \uc0\u1074  \uc0\u1076 \uc0\u1083 \uc0\u1103  SPM4 (\uc0\u1087 \uc0\u1086 \uc0\u1076 \uc0\u1075 \uc0\u1086 \uc0\u1090 \uc0\u1086 \uc0\u1074 \uc0\u1082 \uc0\u1072  \uc0\u1076 \uc0\u1080 \uc0\u1072 \uc0\u1075 \uc0\u1088 \uc0\u1072 \uc0\u1084 \uc0\u1084  \uc0\u1086 \uc0\u1073 \uc0\u1098 \uc0\u1077 \uc0\u1084 \uc0\u1086 \uc0\u1074  \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 ).{\line}- \uc0\u1054 \uc0\u1073 \uc0\u1085 \uc0\u1086 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1089 \uc0\u1083 \uc0\u1072 \uc0\u1081 \uc0\u1076 \uc0\u1086 \uc0\u1074  \uc0\u1076 \uc0\u1083 \uc0\u1103  \uc0\u1074 \uc0\u1089 \uc0\u1090 \uc0\u1088 \uc0\u1077 \uc0\u1095  \uc0\u1088 \uc0\u1091 \uc0\u1082 \uc0\u1086 \uc0\u1074 \uc0\u1086 \uc0\u1076 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1072  (LT Meeting).{\line}- \uc0\u1055 \uc0\u1086 \uc0\u1076 \uc0\u1075 \uc0\u1086 \uc0\u1090 \uc0\u1086 \uc0\u1074 \uc0\u1082 \uc0\u1072 , \uc0\u1087 \uc0\u1083 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1080  \uc0\u1088 \uc0\u1072 \uc0\u1089 \uc0\u1087 \uc0\u1088 \uc0\u1077 \uc0\u1076 \uc0\u1077 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1090 \uc0\u1088 \uc0\u1091 \uc0\u1076 \uc0\u1086 \uc0\u1074 \uc0\u1099 \uc0\u1093  \uc0\u1088 \uc0\u1077 \uc0\u1089 \uc0\u1091 \uc0\u1088 \uc0\u1089 \uc0\u1086 \uc0\u1074  \uc0\u1087 \uc0\u1086  \uc0\u1074 \uc0\u1088 \uc0\u1077 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1080 .\uc0\u1095 \uc0\u1080 \uc0\u1089 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1085 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1080  \uc0\u1087 \uc0\u1077 \uc0\u1088 \uc0\u1089 \uc0\u1086 \uc0\u1085 \uc0\u1072 \uc0\u1083 \uc0\u1072 .{\line}- \uc0\u1042 \uc0\u1077 \uc0\u1076 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1089 \uc0\u1090 \uc0\u1072 \uc0\u1090 \uc0\u1080 \uc0\u1089 \uc0\u1090 \uc0\u1080 \uc0\u1095 \uc0\u1077 \uc0\u1089 \uc0\u1082 \uc0\u1086 \uc0\u1081  \uc0\u1087 \uc0\u1072 \uc0\u1085 \uc0\u1077 \uc0\u1083 \uc0\u1080  \uc0\u1091 \uc0\u1087 \uc0\u1088 \uc0\u1072 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1089 \uc0\u1076 \uc0\u1072 \uc0\u1095 \uc0\u1077 \uc0\u1081  \uc0\u1086 \uc0\u1073 \uc0\u1098 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1086 \uc0\u1074  \uc0\u1074  \uc0\u1101 \uc0\u1082 \uc0\u1089 \uc0\u1087 \uc0\u1083 \uc0\u1091 \uc0\u1072 \uc0\u1090 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1102  (Turnovers Dashboard).{\line}- \uc0\u1055 \uc0\u1086 \uc0\u1076 \uc0\u1075 \uc0\u1086 \uc0\u1090 \uc0\u1086 \uc0\u1074 \uc0\u1082 \uc0\u1072  \uc0\u1086 \uc0\u1090 \uc0\u1095 \uc0\u1077 \uc0\u1090 \uc0\u1072  \uc0\u1086  \uc0\u1089 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1072 \uc0\u1074 \uc0\u1077  \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1095 \uc0\u1077 \uc0\u1081  \uc0\u1089 \uc0\u1080 \uc0\u1083 \uc0\u1099  (\uc0\u1054 \uc0\u1090 \uc0\u1095 \uc0\u1077 \uc0\u1090  \uc0\u1087 \uc0\u1086  \uc0\u1082 \uc0\u1083 \uc0\u1102 \uc0\u1095 \uc0\u1077 \uc0\u1074 \uc0\u1099 \uc0\u1084  \uc0\u1082 \uc0\u1072 \uc0\u1076 \uc0\u1088 \uc0\u1072 \uc0\u1084  KMPR).{\line}- \uc0\u1054 \uc0\u1073 \uc0\u1085 \uc0\u1086 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1086 \uc0\u1090 \uc0\u1095 \uc0\u1077 \uc0\u1090 \uc0\u1072  \uc0\u1087 \uc0\u1086  \uc0\u1091 \uc0\u1087 \uc0\u1088 \uc0\u1072 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1102  \uc0\u1089 \uc0\u1090 \uc0\u1086 \uc0\u1080 \uc0\u1084 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1100 \uc0\u1102  \uc0\u1080  \uc0\u1075 \uc0\u1088 \uc0\u1072 \uc0\u1092 \uc0\u1080 \uc0\u1082 \uc0\u1086 \uc0\u1084 .{\line}- \uc0\u1054 \uc0\u1073 \uc0\u1085 \uc0\u1086 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1075 \uc0\u1085 \uc0\u1086 \uc0\u1079 \uc0\u1072  \uc0\u1087 \uc0\u1086  \uc0\u1087 \uc0\u1080 \uc0\u1090 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1102  (Meal Forecast).{\line} {\line}\uc0\u1048 \uc0\u1102 \uc0\u1085 \uc0\u1100  \uc0\u8211  \uc0\u1054 \uc0\u1082 \uc0\u1090 \uc0\u1103 \uc0\u1073 \uc0\u1088 \uc0\u1100  2023 \uc0\u1075 . \uc0\u1040 \uc0\u1085 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1090 \uc0\u1080 \uc0\u1082  \uc0\u1076 \uc0\u1072 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1093  \uc0\u1087 \uc0\u1086  \uc0\u1087 \uc0\u1083 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1102  \uc0\u1075 \uc0\u1088 \uc0\u1091 \uc0\u1087 \uc0\u1087 \uc0\u1099  \uc0\u1087 \uc0\u1086 \uc0\u1076 \uc0\u1076 \uc0\u1077 \uc0\u1088 \uc0\u1078 \uc0\u1082 \uc0\u1080  \uc0\u1086 \uc0\u1087 \uc0\u1077 \uc0\u1088 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1081  FGP/WPMP{\line}- \uc0\u1056 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1072  \uc0\u1087 \uc0\u1086 \uc0\u1076  \uc0\u1088 \uc0\u1091 \uc0\u1082 \uc0\u1086 \uc0\u1074 \uc0\u1086 \uc0\u1076 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1086 \uc0\u1084  \uc0\u1082 \uc0\u1086 \uc0\u1085 \uc0\u1089 \uc0\u1091 \uc0\u1083 \uc0\u1100 \uc0\u1090 \uc0\u1072 \uc0\u1085 \uc0\u1090 \uc0\u1072  \uc0\u1087 \uc0\u1086  \uc0\u1087 \uc0\u1083 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1102  \uc0\u1087 \uc0\u1086 \uc0\u1076 \uc0\u1076 \uc0\u1077 \uc0\u1088 \uc0\u1078 \uc0\u1082 \uc0\u1080  \uc0\u1086 \uc0\u1087 \uc0\u1077 \uc0\u1088 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1081 {\line}- \uc0\u1059 \uc0\u1095 \uc0\u1072 \uc0\u1089 \uc0\u1090 \uc0\u1080 \uc0\u1077  \uc0\u1074  \uc0\u1088 \uc0\u1072 \uc0\u1079 \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1082 \uc0\u1077  WBS  (\uc0\u1088 \uc0\u1072 \uc0\u1079 \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1082 \uc0\u1072  \uc0\u1080 \uc0\u1077 \uc0\u1088 \uc0\u1072 \uc0\u1088 \uc0\u1093 \uc0\u1080 \uc0\u1095 \uc0\u1077 \uc0\u1089 \uc0\u1082 \uc0\u1086 \uc0\u1081  \uc0\u1089 \uc0\u1090 \uc0\u1088 \uc0\u1091 \uc0\u1082 \uc0\u1090 \uc0\u1091 \uc0\u1088 \uc0\u1099  \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 )  \uc0\u1076 \uc0\u1083 \uc0\u1103  \uc0\u1091 \uc0\u1095 \uc0\u1077 \uc0\u1090 \uc0\u1072  \uc0\u1088 \uc0\u1077 \uc0\u1079 \uc0\u1091 \uc0\u1083 \uc0\u1100 \uc0\u1090 \uc0\u1072 \uc0\u1090 \uc0\u1086 \uc0\u1074  \uc0\u1076 \uc0\u1077 \uc0\u1103 \uc0\u1090 \uc0\u1077 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1080  \uc0\u1089 \uc0\u1083 \uc0\u1091 \uc0\u1078 \uc0\u1073 \uc0\u1099  \uc0\u1087 \uc0\u1086 \uc0\u1076 \uc0\u1076 \uc0\u1077 \uc0\u1088 \uc0\u1078 \uc0\u1082 \uc0\u1080  \uc0\u1086 \uc0\u1087 \uc0\u1077 \uc0\u1088 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1081 ..{\line}- \uc0\u1055 \uc0\u1086 \uc0\u1076 \uc0\u1075 \uc0\u1086 \uc0\u1090 \uc0\u1086 \uc0\u1074 \uc0\u1082 \uc0\u1072  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1086 \uc0\u1074  \uc0\u1086 \uc0\u1090 \uc0\u1095 \uc0\u1077 \uc0\u1090 \uc0\u1086 \uc0\u1074  \uc0\u1086  \uc0\u1093 \uc0\u1086 \uc0\u1076 \uc0\u1077  \uc0\u1074 \uc0\u1099 \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1085 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 , \uc0\u1074 \uc0\u1079 \uc0\u1072 \uc0\u1080 \uc0\u1084 \uc0\u1086 \uc0\u1076 \uc0\u1077 \uc0\u1081 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1080 \uc0\u1077  \uc0\u1089  \uc0\u1086 \uc0\u1090 \uc0\u1074 \uc0\u1077 \uc0\u1090 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1077 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1084 \uc0\u1080  \uc0\u1083 \uc0\u1080 \uc0\u1094 \uc0\u1072 \uc0\u1084 \uc0\u1080  \uc0\u1076 \uc0\u1083 \uc0\u1103  \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1091 \uc0\u1095 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1090 \uc0\u1086 \uc0\u1095 \uc0\u1085 \uc0\u1099 \uc0\u1093  \uc0\u1076 \uc0\u1072 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1093  \uc0\u1086  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1075 \uc0\u1088 \uc0\u1077 \uc0\u1089 \uc0\u1089 \uc0\u1077  \uc0\u1086 \uc0\u1090 \uc0\u1085 \uc0\u1086 \uc0\u1089 \uc0\u1080 \uc0\u1090 \uc0\u1077 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1086  \uc0\u1087 \uc0\u1083 \uc0\u1072 \uc0\u1085 \uc0\u1072 {\line}- \uc0\u1054 \uc0\u1073 \uc0\u1085 \uc0\u1086 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1075 \uc0\u1088 \uc0\u1072 \uc0\u1092 \uc0\u1080 \uc0\u1082 \uc0\u1086 \uc0\u1074  \uc0\u1085 \uc0\u1072  \uc0\u1086 \uc0\u1089 \uc0\u1085 \uc0\u1086 \uc0\u1074 \uc0\u1077  \uc0\u1080 \uc0\u1085 \uc0\u1092 \uc0\u1086 \uc0\u1088 \uc0\u1084 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1080  \uc0\u1080 \uc0\u1079  \uc0\u1074 \uc0\u1085 \uc0\u1077 \uc0\u1096 \uc0\u1085 \uc0\u1080 \uc0\u1093  \uc0\u1080 \uc0\u1089 \uc0\u1090 \uc0\u1086 \uc0\u1095 \uc0\u1085 \uc0\u1080 \uc0\u1082 \uc0\u1086 \uc0\u1074  \uc0\u1076 \uc0\u1083 \uc0\u1103  \uc0\u1074 \uc0\u1099 \uc0\u1103 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1074 \uc0\u1086 \uc0\u1079 \uc0\u1084 \uc0\u1086 \uc0\u1078 \uc0\u1085 \uc0\u1099 \uc0\u1093  \uc0\u1082 \uc0\u1086 \uc0\u1085 \uc0\u1092 \uc0\u1083 \uc0\u1080 \uc0\u1082 \uc0\u1090 \uc0\u1086 \uc0\u1074 .{\line}- \uc0\u1058 \uc0\u1077 \uc0\u1089 \uc0\u1085 \uc0\u1086 \uc0\u1077  \uc0\u1074 \uc0\u1079 \uc0\u1072 \uc0\u1080 \uc0\u1084 \uc0\u1086 \uc0\u1076 \uc0\u1077 \uc0\u1081 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1080 \uc0\u1077  \uc0\u1089  \uc0\u1087 \uc0\u1077 \uc0\u1088 \uc0\u1089 \uc0\u1086 \uc0\u1085 \uc0\u1072 \uc0\u1083 \uc0\u1086 \uc0\u1084  \uc0\u1087 \uc0\u1086  \uc0\u1087 \uc0\u1083 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1102  \uc0\u1086 \uc0\u1087 \uc0\u1077 \uc0\u1088 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1081  \uc0\u1080  \uc0\u1079 \uc0\u1072 \uc0\u1074 \uc0\u1077 \uc0\u1088 \uc0\u1096 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1089 \uc0\u1090 \uc0\u1088 \uc0\u1086 \uc0\u1080 \uc0\u1090 \uc0\u1077 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1086 -\uc0\u1084 \uc0\u1086 \uc0\u1085 \uc0\u1090 \uc0\u1072 \uc0\u1078 \uc0\u1085 \uc0\u1099 \uc0\u1093  \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090  \uc0\u1080  \uc0\u1087 \uc0\u1086 \uc0\u1076 \uc0\u1075 \uc0\u1086 \uc0\u1090 \uc0\u1086 \uc0\u1074 \uc0\u1082 \uc0\u1072  \uc0\u1089 \uc0\u1080 \uc0\u1089 \uc0\u1090 \uc0\u1077 \uc0\u1084  \uc0\u1082  \uc0\u1087 \uc0\u1091 \uc0\u1089 \uc0\u1082 \uc0\u1086 \uc0\u1085 \uc0\u1072 \uc0\u1083 \uc0\u1072 \uc0\u1076 \uc0\u1082 \uc0\u1077 .{\line}- \uc0\u1042 \uc0\u1074 \uc0\u1086 \uc0\u1076  \uc0\u1076 \uc0\u1072 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1093  \uc0\u1074  P6 (Primavera), \uc0\u1082 \uc0\u1072 \uc0\u1089 \uc0\u1072 \uc0\u1102 \uc0\u1097 \uc0\u1080 \uc0\u1093 \uc0\u1089 \uc0\u1103  \uc0\u1087 \uc0\u1077 \uc0\u1088 \uc0\u1089 \uc0\u1086 \uc0\u1085 \uc0\u1072 \uc0\u1083 \uc0\u1072 , \uc0\u1075 \uc0\u1088 \uc0\u1072 \uc0\u1092 \uc0\u1080 \uc0\u1082 \uc0\u1086 \uc0\u1074 , \uc0\u1086 \uc0\u1073 \uc0\u1091 \uc0\u1095 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1080  \uc0\u1090 \uc0\u1088 \uc0\u1077 \uc0\u1073 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1081  \uc0\u1082  \uc0\u1087 \uc0\u1091 \uc0\u1089 \uc0\u1082 \uc0\u1086 \uc0\u1085 \uc0\u1072 \uc0\u1083 \uc0\u1072 \uc0\u1076 \uc0\u1086 \uc0\u1095 \uc0\u1085 \uc0\u1099 \uc0\u1084  \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1072 \uc0\u1084 .{\line}- \uc0\u1057 \uc0\u1086 \uc0\u1076 \uc0\u1077 \uc0\u1081 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1080 \uc0\u1077  \uc0\u1086 \uc0\u1073 \uc0\u1077 \uc0\u1089 \uc0\u1087 \uc0\u1077 \uc0\u1095 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1102  \uc0\u1073 \uc0\u1077 \uc0\u1079 \uc0\u1072 \uc0\u1074 \uc0\u1072 \uc0\u1088 \uc0\u1080 \uc0\u1081 \uc0\u1085 \uc0\u1086 \uc0\u1081  \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1099 , \uc0\u1082 \uc0\u1086 \uc0\u1085 \uc0\u1090 \uc0\u1088 \uc0\u1086 \uc0\u1083 \uc0\u1100  \uc0\u1089 \uc0\u1086 \uc0\u1073 \uc0\u1083 \uc0\u1102 \uc0\u1076 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1054 \uc0\u1087 \uc0\u1077 \uc0\u1088 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1086 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1093  \uc0\u1087 \uc0\u1088 \uc0\u1080 \uc0\u1085 \uc0\u1094 \uc0\u1080 \uc0\u1087 \uc0\u1086 \uc0\u1074  \uc0\u1080  \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1080 \uc0\u1090 \uc0\u1080 \uc0\u1082 \uc0\u1080  \uc0\u1054 \uc0\u1058 , \uc0\u1058 \uc0\u1041  \uc0\u1080  \uc0\u1054 \uc0\u1054 \uc0\u1057  \uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1087 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1080  \uc0\u1058 \uc0\u1064 \uc0\u1054 {\line}- \uc0\u1055 \uc0\u1086 \uc0\u1084 \uc0\u1086 \uc0\u1097 \uc0\u1100  \uc0\u1082 \uc0\u1086 \uc0\u1085 \uc0\u1089 \uc0\u1091 \uc0\u1083 \uc0\u1100 \uc0\u1090 \uc0\u1072 \uc0\u1085 \uc0\u1090 \uc0\u1091  \uc0\u1074  \uc0\u1088 \uc0\u1072 \uc0\u1079 \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1082 \uc0\u1077  \uc0\u1075 \uc0\u1088 \uc0\u1072 \uc0\u1092 \uc0\u1080 \uc0\u1082 \uc0\u1086 \uc0\u1074  4-\uc0\u1075 \uc0\u1086 /5-\uc0\u1075 \uc0\u1086  \uc0\u1091 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1085 \uc0\u1077 \uc0\u1081  \uc0\u1080  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1094 \uc0\u1077 \uc0\u1089 \uc0\u1089  \uc0\u1076 \uc0\u1086 \uc0\u1073 \uc0\u1072 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1090 \uc0\u1088 \uc0\u1091 \uc0\u1076 \uc0\u1086 \uc0\u1079 \uc0\u1072 \uc0\u1090 \uc0\u1088 \uc0\u1072 \uc0\u1090 , \uc0\u1084 \uc0\u1072 \uc0\u1090 \uc0\u1077 \uc0\u1088 \uc0\u1080 \uc0\u1072 \uc0\u1083 \uc0\u1086 \uc0\u1074  \uc0\u1080 \uc0\u1083 \uc0\u1080  \uc0\u1086 \uc0\u1073 \uc0\u1086 \uc0\u1088 \uc0\u1091 \uc0\u1076 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1074  \uc0\u1075 \uc0\u1088 \uc0\u1072 \uc0\u1092 \uc0\u1080 \uc0\u1082  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1072 .{\line}{\line}\uc0\u1052 \uc0\u1072 \uc0\u1088 \uc0\u1090  2014- 2018 3\uc0\u1058 \uc0\u1055   \uc0\u1055 \uc0\u1041 \uc0\u1056 /\uc0\u1055 \uc0\u1059 \uc0\u1059 \uc0\u1044  \uc0\u1058 \uc0\u1041  \uc0\u1050 \uc0\u1086 \uc0\u1086 \uc0\u1088 \uc0\u1076 \uc0\u1080 \uc0\u1085 \uc0\u1072 \uc0\u1090 \uc0\u1086 \uc0\u1088  \uc0\u1087 \uc0\u1086  \uc0\u1085 \uc0\u1072 \uc0\u1088 \uc0\u1103 \uc0\u1076 \uc0\u1072 \uc0\u1084  \uc0\u1076 \uc0\u1086 \uc0\u1087 \uc0\u1091 \uc0\u1089 \uc0\u1082 \uc0\u1072 \uc0\u1084 {\line}\uc0\u1058 \uc0\u1041  \uc0\u1050 \uc0\u1086 \uc0\u1086 \uc0\u1088 \uc0\u1076 \uc0\u1080 \uc0\u1085 \uc0\u1072 \uc0\u1090 \uc0\u1086 \uc0\u1088  \uc0\u1087 \uc0\u1086  \uc0\u1085 \uc0\u1072 \uc0\u1088 \uc0\u1103 \uc0\u1076 \uc0\u1072 \uc0\u1084  \uc0\u1076 \uc0\u1086 \uc0\u1087 \uc0\u1091 \uc0\u1089 \uc0\u1082 \uc0\u1072 \uc0\u1084 {\line}{\line}- \uc0\u1054 \uc0\u1090 \uc0\u1089 \uc0\u1083 \uc0\u1077 \uc0\u1078 \uc0\u1080 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1080  \uc0\u1082 \uc0\u1086 \uc0\u1086 \uc0\u1088 \uc0\u1076 \uc0\u1080 \uc0\u1085 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1103  \uc0\u1074 \uc0\u1089 \uc0\u1077 \uc0\u1093  \uc0\u1085 \uc0\u1072 \uc0\u1088 \uc0\u1103 \uc0\u1076 \uc0\u1086 \uc0\u1074  \uc0\u1055 \uc0\u1041 \uc0\u1056 {\line}- \uc0\u1055 \uc0\u1083 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1080 \uc0\u1085 \uc0\u1089 \uc0\u1087 \uc0\u1077 \uc0\u1082 \uc0\u1094 \uc0\u1080 \uc0\u1086 \uc0\u1085 \uc0\u1085 \uc0\u1086 \uc0\u1081  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1077 \uc0\u1088 \uc0\u1082 \uc0\u1080  \uc0\u1087 \uc0\u1086  \uc0\u1085 \uc0\u1072 \uc0\u1088 \uc0\u1103 \uc0\u1076 \uc0\u1072 \uc0\u1084  \uc0\u1076 \uc0\u1086 \uc0\u1087 \uc0\u1091 \uc0\u1089 \uc0\u1082 \uc0\u1072 \uc0\u1084 , \uc0\u1077 \uc0\u1078 \uc0\u1077 \uc0\u1085 \uc0\u1077 \uc0\u1076 \uc0\u1077 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1099 \uc0\u1077  \uc0\u1072 \uc0\u1091 \uc0\u1076 \uc0\u1080 \uc0\u1090 \uc0\u1099 , \uc0\u1074 \uc0\u1085 \uc0\u1077 \uc0\u1086 \uc0\u1095 \uc0\u1077 \uc0\u1088 \uc0\u1077 \uc0\u1076 \uc0\u1085 \uc0\u1099 \uc0\u1077  \uc0\u1072 \uc0\u1091 \uc0\u1076 \uc0\u1080 \uc0\u1090 \uc0\u1099 .{\line}- \uc0\u1045 \uc0\u1078 \uc0\u1077 \uc0\u1076 \uc0\u1085 \uc0\u1077 \uc0\u1074 \uc0\u1085 \uc0\u1099 \uc0\u1081  \uc0\u1084 \uc0\u1086 \uc0\u1085 \uc0\u1080 \uc0\u1090 \uc0\u1086 \uc0\u1088 \uc0\u1080 \uc0\u1085 \uc0\u1075  \uc0\u1085 \uc0\u1072 \uc0\u1088 \uc0\u1103 \uc0\u1076 \uc0\u1086 \uc0\u1074  \uc0\u1085 \uc0\u1072  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1077  \uc0\u1076 \uc0\u1083 \uc0\u1103  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1077 \uc0\u1088 \uc0\u1082 \uc0\u1080  \uc0\u1089 \uc0\u1086 \uc0\u1086 \uc0\u1090 \uc0\u1074 \uc0\u1077 \uc0\u1090 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1080 \uc0\u1103  \uc0\u1090 \uc0\u1088 \uc0\u1077 \uc0\u1073 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1103 \uc0\u1084  \uc0\u1058 \uc0\u1041  \uc0\u1055 \uc0\u1041 \uc0\u1056 {\line}- \uc0\u1055 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1077 \uc0\u1088 \uc0\u1082 \uc0\u1072  \uc0\u1074 \uc0\u1099 \uc0\u1076 \uc0\u1072 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1093  \uc0\u1086 \uc0\u1090 \uc0\u1076 \uc0\u1077 \uc0\u1083 \uc0\u1086 \uc0\u1084  \uc0\u1058 \uc0\u1041  \uc0\u1088 \uc0\u1072 \uc0\u1079 \uc0\u1088 \uc0\u1077 \uc0\u1096 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1081  \uc0\u1085 \uc0\u1072  \uc0\u1074 \uc0\u1099 \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1085 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090  \uc0\u1085 \uc0\u1072  \uc0\u1086 \uc0\u1073 \uc0\u1098 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1077  \uc0\u1089 \uc0\u1090 \uc0\u1088 \uc0\u1086 \uc0\u1080 \uc0\u1090 \uc0\u1077 \uc0\u1083 \uc0\u1100 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1072  \uc0\u1076 \uc0\u1083 \uc0\u1103  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1077 \uc0\u1088 \uc0\u1082 \uc0\u1080  \uc0\u1089 \uc0\u1086 \uc0\u1086 \uc0\u1090 \uc0\u1074 \uc0\u1077 \uc0\u1090 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1080 \uc0\u1103  \uc0\u1090 \uc0\u1088 \uc0\u1077 \uc0\u1073 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1103 \uc0\u1084 , \uc0\u1076 \uc0\u1083 \uc0\u1103  \uc0\u1086 \uc0\u1073 \uc0\u1077 \uc0\u1089 \uc0\u1087 \uc0\u1077 \uc0\u1095 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1073 \uc0\u1077 \uc0\u1079 \uc0\u1086 \uc0\u1087 \uc0\u1072 \uc0\u1089 \uc0\u1085 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1080  \uc0\u1087 \uc0\u1088 \uc0\u1080 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1082 \uc0\u1072 \uc0\u1077 \uc0\u1084 \uc0\u1099 \uc0\u1093  \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1085 \uc0\u1080 \uc0\u1082 \uc0\u1086 \uc0\u1074  \uc0\u1080  \uc0\u1074 \uc0\u1099 \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1085 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 .{\line}- \uc0\u1040 \uc0\u1076 \uc0\u1084 \uc0\u1080 \uc0\u1085 \uc0\u1080 \uc0\u1089 \uc0\u1090 \uc0\u1088 \uc0\u1072 \uc0\u1090 \uc0\u1080 \uc0\u1074 \uc0\u1085 \uc0\u1099 \uc0\u1077  \uc0\u1086 \uc0\u1073 \uc0\u1103 \uc0\u1079 \uc0\u1072 \uc0\u1085 \uc0\u1085 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1080 {\line}{\line}{\line} {\line}January-May 2018- 2023 Project FGP/WPMP C&P System Completion and IOCC Planning Analyst.{\line}Experienced in Primavera P6, data analysis, progress tracking, schedule updates and reporting.{\line}Hands-on experience working with SQL, Power BI, Excel and Primavera P6 for data analysis, reporting and planning activities.{\line}Experienced in monitoring progress against plan, updating schedules, identifying schedule conflicts and supporting project teams with planning and reporting activities.{\line}- Provide project planning support to the Area/Lead Planner to ensure timely and accurate delivery of all progress and planning related processes, reports create new schedules in P6 and update existing schedules.{\line}- Assist in the implementation, administration and maintenance of systems and schedule control procedures to track project plans and forecasts.{\line}- Work and maintain the overall construction plan of the project as directed by the site planner.{\line}- Assess schedule trends and ensure Contractor correctly highlights such trends in periodic reports.{\line}- - Review Contractor reports and ensure correct progress reporting and highlighting of significant issues/concerns.{\line}- - Prepare and issue reports and data as required.{\line}- Update monthly, weekly report and data as required.{\line}- Commodity chart for SPM4.{\line}- LT Meeting Slides Update.{\line}- SC Manpower Histogram.{\line}- Turnovers Dashboard Statistic.{\line}- Manpower Workforce report (KMPR).{\line}- Update Cost Schedule stewardship Report.{\line}- Update Report Meal Forecast.{\line}{\line}{\line}June - October 2023 FGP/WPMP Operations Support Group Planning Data Analyst.{\line}- Reports to Operations Support Planning Consultant.{\line}- Assists in development of Work Breakdown Structure (WBS) to reflect Operations Support deliverables.{\line}- Prepares Draft progress reports, engages with individuals to accurately understand progress against plan.{\line}- Update schedules from information from other sources to identify any conflict.{\line}- Liaises closely with Operations & Systems Completion planning personnel.{\line}- Data input to P6 writing, Personnel, Rotations, Training & Commissioning requirements.{\line}- Contributes to incident free operations and ensures compliance with Operational Tenets and HSE Policy of TCO.{\line}- Assists Consultant to build and resource load a Level 4/5 schedule.{\line} {\line}March 2014-2018 FGP/WPMP 3GP HSE Permit Coordinator{\line}- Tracking and coordination of all HSE Permits{\line}- Scheduling of HSE Permit Audits/Inspections on a weekly basis or at a more frequent schedule if determined by audit/inspection results.{\line}- Daily monitoring of the Project HSE Permit work activities to ensure compliance with FGP HSE requirements.{\line}- Reviewing the HSE Work Permits on the Project to ensure continued compliance for enhancement of safety for both the work and the workers involved{\line}- Administration and general clerk duties.{\line}- Check work permits for administrative items, such as if all required signatures are in place, if PPHA is available for the job, if the permit validity period complies with SI-105 or FO\uc0\u8217 s defined time frame.{\line}- Notify FO in case of a potential SIMOPS issues (e.g., work on the same equipment / area where other crews have open permits for.{\line}- Ensure timely registration of permits to avoid delays in work.{\line}- Perform administrative tasks as delegated by the FO.}

