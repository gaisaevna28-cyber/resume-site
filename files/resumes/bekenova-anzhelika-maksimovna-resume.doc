\pard\intbl\itap1\sl280{\fs24\b \uc0\u1040 \uc0\u1083 \uc0\u1084 \uc0\u1072 -\uc0\u1040 \uc0\u1090 \uc0\u1080 \uc0\u1085 \uc0\u1089 \uc0\u1082 \uc0\u1080 \uc0\u1081  \uc0\u1080 \uc0\u1085 \uc0\u1089 \uc0\u1090 \uc0\u1080 \uc0\u1090 \uc0\u1091 \uc0\u1090  \uc0\u1080 \uc0\u1085 \uc0\u1078 \uc0\u1077 \uc0\u1085 \uc0\u1077 \uc0\u1088 \uc0\u1086 \uc0\u1074  \uc0\u1090 \uc0\u1088 \uc0\u1072 \uc0\u1085 \uc0\u1089 \uc0\u1087 \uc0\u1086 \uc0\u1088 \uc0\u1090 \uc0\u1072  (\uc0\u1050 \uc0\u1072 \uc0\u1079 \uc0\u1040 \uc0\u1058 \uc0\u1050 )}\par
\pard\intbl\itap1\sl260{\fs18 \uc0\u1069 \uc0\u1085 \uc0\u1077 \uc0\u1088 \uc0\u1075 \uc0\u1086 \uc0\u1089 \uc0\u1085 \uc0\u1072 \uc0\u1073 \uc0\u1078 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077 , \uc0\u1048 \uc0\u1085 \uc0\u1078 \uc0\u1077 \uc0\u1085 \uc0\u1077 \uc0\u1088  \uc0\u8211  \uc0\u1101 \uc0\u1083 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1088 \uc0\u1080 \uc0\u1082 }
