\pard\intbl\itap1\sl280{\fs24\b \uc0\u1052 \uc0\u1077 \uc0\u1078 \uc0\u1076 \uc0\u1091 \uc0\u1085 \uc0\u1072 \uc0\u1088 \uc0\u1086 \uc0\u1076 \uc0\u1085 \uc0\u1072 \uc0\u1103  \uc0\u1072 \uc0\u1082 \uc0\u1072 \uc0\u1076 \uc0\u1077 \uc0\u1084 \uc0\u1080 \uc0\u1103  \uc0\u1085 \uc0\u1072 \uc0\u1091 \uc0\u1082  \uc0\u1057 \uc0\u1072 \uc0\u1085 -\uc0\u1052 \uc0\u1072 \uc0\u1088 \uc0\u1080 \uc0\u1085 \uc0\u1086 , \uc0\u1092 \uc0\u1080 \uc0\u1083 \uc0\u1080 \uc0\u1072 \uc0\u1083  \uc0\u1075 .\uc0\u1052 \uc0\u1086 \uc0\u1089 \uc0\u1082 \uc0\u1074 \uc0\u1072 }\par
