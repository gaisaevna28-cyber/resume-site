\pard\intbl\itap1\sl280\sb60\sa60{\fs24 \uc0\u1057 \uc0\u1080 \uc0\u1089 \uc0\u1090 \uc0\u1077 \uc0\u1084 \uc0\u1085 \uc0\u1099 \uc0\u1081  / BI-\uc0\u1072 \uc0\u1085 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1090 \uc0\u1080 \uc0\u1082 , IT Project Management\par}

\pard\intbl\itap1\sl260\sa60{\fs18 \uc0\u1055 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1086 \uc0\u1076 \uc0\u1080 \uc0\u1083 \uc0\u1072  \uc0\u1080 \uc0\u1085 \uc0\u1090 \uc0\u1077 \uc0\u1088 \uc0\u1074 \uc0\u1100 \uc0\u1102  \uc0\u1089  \uc0\u1073 \uc0\u1080 \uc0\u1079 \uc0\u1085 \uc0\u1077 \uc0\u1089  \uc0\u1079 \uc0\u1072 \uc0\u1082 \uc0\u1072 \uc0\u1079 \uc0\u1095 \uc0\u1080 \uc0\u1082 \uc0\u1072 \uc0\u1084 \uc0\u1080 , \uc0\u1074 \uc0\u1099 \uc0\u1103 \uc0\u1074 \uc0\u1083 \uc0\u1103 \uc0\u1083 \uc0\u1072  \uc0\u1087 \uc0\u1086 \uc0\u1090 \uc0\u1088 \uc0\u1077 \uc0\u1073 \uc0\u1085 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1080  \uc0\u1080  \uc0\u1073 \uc0\u1080 \uc0\u1079 \uc0\u1085 \uc0\u1077 \uc0\u1089 -\uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1073 \uc0\u1083 \uc0\u1077 \uc0\u1084 \uc0\u1099 .{\line}\uc0\u1060 \uc0\u1086 \uc0\u1088 \uc0\u1084 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1079 \uc0\u1086 \uc0\u1074 \uc0\u1099 \uc0\u1074 \uc0\u1072 \uc0\u1083 \uc0\u1072  \uc0\u1090 \uc0\u1088 \uc0\u1077 \uc0\u1073 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1074  Notion, \uc0\u1075 \uc0\u1086 \uc0\u1090 \uc0\u1086 \uc0\u1074 \uc0\u1080 \uc0\u1083 \uc0\u1072  \uc0\u1058 \uc0\u1047 , User Stories, Use Cases \uc0\u1080  Acceptance Criteria \uc0\u1089  \uc0\u1080 \uc0\u1089 \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1100 \uc0\u1079 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1077 \uc0\u1084  Given/When/Then.{\line}\uc0\u1057 \uc0\u1084 \uc0\u1086 \uc0\u1076 \uc0\u1077 \uc0\u1083 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1083 \uc0\u1072  \uc0\u1086 \uc0\u1082 \uc0\u1086 \uc0\u1083 \uc0\u1086  50 \uc0\u1073 \uc0\u1080 \uc0\u1079 \uc0\u1085 \uc0\u1077 \uc0\u1089 -\uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1094 \uc0\u1077 \uc0\u1089 \uc0\u1089 \uc0\u1086 \uc0\u1074  \uc0\u1074  BPMN, \uc0\u1074 \uc0\u1082 \uc0\u1083 \uc0\u1102 \uc0\u1095 \uc0\u1072 \uc0\u1103  As-Is / To-Be, \uc0\u1074 \uc0\u1099 \uc0\u1103 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1091 \uc0\u1079 \uc0\u1082 \uc0\u1080 \uc0\u1093  \uc0\u1084 \uc0\u1077 \uc0\u1089 \uc0\u1090  \uc0\u1080  \uc0\u1086 \uc0\u1087 \uc0\u1090 \uc0\u1080 \uc0\u1084 \uc0\u1080 \uc0\u1079 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1102  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1094 \uc0\u1077 \uc0\u1089 \uc0\u1089 \uc0\u1086 \uc0\u1074 .{\line}\uc0\u1055 \uc0\u1088 \uc0\u1086 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1083 \uc0\u1072  \uc0\u1074 \uc0\u1085 \uc0\u1091 \uc0\u1090 \uc0\u1088 \uc0\u1077 \uc0\u1085 \uc0\u1085 \uc0\u1080 \uc0\u1077  IT-\uc0\u1089 \uc0\u1077 \uc0\u1088 \uc0\u1074 \uc0\u1080 \uc0\u1089 \uc0\u1099 , \uc0\u1074 \uc0\u1082 \uc0\u1083 \uc0\u1102 \uc0\u1095 \uc0\u1072 \uc0\u1103  \uc0\u1082 \uc0\u1072 \uc0\u1073 \uc0\u1080 \uc0\u1085 \uc0\u1077 \uc0\u1090  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1097 \uc0\u1080 \uc0\u1082 \uc0\u1072  \uc0\u1080  \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1095 \uc0\u1077 \uc0\u1077  \uc0\u1086 \uc0\u1082 \uc0\u1085 \uc0\u1086  \uc0\u1076 \uc0\u1083 \uc0\u1103  \uc0\u1082 \uc0\u1086 \uc0\u1083 \uc0\u1083 -\uc0\u1094 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1088 \uc0\u1072 .{\line}\uc0\u1044 \uc0\u1077 \uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1087 \uc0\u1086 \uc0\u1079 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1083 \uc0\u1072  \uc0\u1090 \uc0\u1088 \uc0\u1077 \uc0\u1073 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1080  \uc0\u1073 \uc0\u1080 \uc0\u1079 \uc0\u1085 \uc0\u1077 \uc0\u1089 -\uc0\u1079 \uc0\u1072 \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1089 \uc0\u1099  \uc0\u1085 \uc0\u1072  \uc0\u1079 \uc0\u1072 \uc0\u1076 \uc0\u1072 \uc0\u1095 \uc0\u1080  \uc0\u1076 \uc0\u1083 \uc0\u1103  \uc0\u1088 \uc0\u1072 \uc0\u1079 \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1082 \uc0\u1080 , \uc