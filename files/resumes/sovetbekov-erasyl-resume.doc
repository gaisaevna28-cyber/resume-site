Shai.pro
}\par

\pard\intbl\itap1\sl260{\fs18\cf1\uc0\u1040 \uc0\u1089 \uc0\u1090 \uc0\u1072 \uc0\u1085 \uc0\u1072 }\par


\pard\intbl\itap1\sl280\sb60\sa60{\fs24 QA Engineer AI agents and platforms\par}

\pard\intbl\itap1\sl260\sa60{\fs18 * Developed and executed automated testing strategies for multi-agent systems, validating complex reasoning chains and modular state handling.{\line}* Designed and implemented E2E automated evaluation pipelines for enterprise RAG deployments, utilizing frameworks like DeepEval, Ragas, and LangFuse to track retrieval precision (+18%) and reduce hallucination rates (~22%).{\line}* Led integration and API testing for conversational and workflow automation agents (e.g., Google Meet summarization pipelines), cutting the prototype-to-production cycle by 40%.{\line}* Formulated data quality validations and load tests for fine-tuned M3 embedding models, verifying a ~90% retrieval accuracy on client-specific datasets{\line}* Replaced multi-hour manual analytical processes for a railway company with a fully automated pipeline that detects and localizes fault defects in seconds{\line}* Monitored data consistency and query performance across PostgreSQL and vector similarity search systems like Weaviate.{\line}* Managed code quality and engineering standards through rigorous code reviews and pair programming, reducing onboarding time for junior engineers by 50% and improving PR acceptance rates by ~35%.{\line}* Conducted corporate workshops on LLM concepts, prompt engineering, and agent design validation for over 50 enterprise client employees{\line}* Conducted load and performance testing via Python and Locust for a high-traffic hackathon solution, ensuring system stability, measuring response latencies, and identifying backend bottlenecks under peak simulated user concurrency.{\line}{\line}* \uc0\u1056 \uc0\u1072 \uc0\u1079 \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1072 \uc0\u1090 \uc0\u1099 \uc0\u1074 \uc0\u1072 \uc0\u1083  \uc0\u1080  \uc0\u1088 \uc0\u1077 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1079 \uc0\u1086 \uc0\u1074 \uc0\u1099 \uc0\u1074 \uc0\u1072 \uc0\u1083  \uc0\u1089 \uc0\u1090 \uc0\u1088 \uc0\u1072 \uc0\u1090 \uc0\u1077 \uc0\u1075 \uc0\u1080 \uc0\u1080  \uc0\u1072 \uc0\u1074 \uc0\u1090 \uc0\u1086 \uc0\u1084 \uc0\u1072 \uc0\u1090 \uc0\u1080 \uc0\u1079 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1085 \uc0\u1086 \uc0\u1075 \uc0\u1086  \uc0\u1090 \uc0\u1077 \uc0\u1089 \uc0\u1090 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1076 \uc0\u1083 \uc0\u1103  multi-agent \uc0\u1089 \uc0\u1080 \uc0\u1089 \uc0\u1090 \uc0\u1077 \uc0\u1084 , \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1077 \uc0\u1088 \uc0\u1103 \uc0\u1103  \uc0\u1089 \uc0\u1083 \uc0\u1086 \uc0\u1078 \uc0\u1085 \uc0\u1099 \uc0\u1077  \uc0\u1094 \uc0\u1077 \uc0\u1087 \uc0\u1086 \uc0\u1095 \uc0\u1082 \uc0\u1080  \uc0\u1088 \uc0\u1072 \uc0\u1089 \uc0\u1089 \uc0\u1091 \uc0\u1078 \uc0\u1076 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1081  \uc0\u1080  \uc0\u1084 \uc0\u1086 \uc0\u1076 \uc0\u1091 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1091 \uc0\u1102  \uc0\u1086 \uc0\u1073 \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1082 \uc0\u1091  \uc0\u1089 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1086 \uc0\u1103 \uc0\u1085 \uc0\u1080 \uc0\u1081 .{\line}* \uc0\u1055 \uc0\u1088 \uc0\u1086 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1083  \uc0\u1080  \uc0\u1074 \uc0\u1085 \uc0\u1077 \uc0\u1076 \uc0\u1088 \uc0\u1103 \uc0\u1083  E2E-\uc0\u1087 \uc0\u1072 \uc0\u1081 \uc0\u1087 \uc0\u1083 \uc0\u1072 \uc0\u1081 \uc0\u1085 \uc0\u1099  \uc0\u1072 \uc0\u1074 \uc0\u1090 \uc0\u1086 \uc0\u1084 \uc0\u1072 \uc0\u1090 \uc0\u1080 \uc0\u1079 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1085 \uc0\u1086 \uc0\u1081  \uc0\u1086 \uc0\u1094 \uc0\u1077 \uc0\u1085 \uc0\u1082 \uc0\u1080  \uc0\u1076 \uc0\u1083 \uc0\u1103  enterprise RAG-\uc0\u1088 \uc0\u1077 \uc0\u1096 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1081 , \uc0\u1080 \uc0\u1089 \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1100 \uc0\u1079 \uc0\u1091 \uc0\u1103  DeepEval, Ragas \uc0\u1080  LangFuse \uc0\u1076 \uc0\u1083 \uc0\u1103  \uc0\u1086 \uc0\u1090 \uc0\u1089 \uc0\u1083 \uc0\u1077 \uc0\u1078 \uc0\u1080 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1103  retrieval precision. \uc0\u1055 \uc0\u1086 \uc0\u1074 \uc0\u1099 \uc0\u1089 \uc0\u1080 \uc0\u1083  \uc0\u1090 \uc0\u1086 \uc0\u1095 \uc0\u1085 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1100  \uc0\u1087 \uc0\u1086 \uc0\u1080 \uc0\u1089 \uc0\u1082 \uc0\u1072  \uc0\u1085 \uc0\u1072  18% \uc0\u1080  \uc0\u1089 \uc0\u1085 \uc0\u1080 \uc0\u1079 \uc0\u1080 \uc0\u1083  \uc0\u1091 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1077 \uc0\u1085 \uc0\u1100  \uc0\u1075 \uc0\u1072 \uc0\u1083 \uc0\u1083 \uc0\u1102 \uc0\u1094 \uc0\u1080 \uc0\u1085 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1081  \uc0\u1087 \uc0\u1088 \uc0\u1080 \uc0\u1084 \uc0\u1077 \uc0\u1088 \uc0\u1085 \uc0\u1086  \uc0\u1085 \uc0\u1072  22%.{\line}* \uc0\u1056 \uc0\u1091 \uc0\u1082 \uc0\u1086 \uc0\u1074 \uc0\u1086 \uc0\u1076 \uc0\u1080 \uc0\u1083  \uc0\u1080 \uc0\u1085 \uc0\u1090 \uc0\u1077 \uc0\u1075 \uc0\u1088 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1086 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1084  \uc0\u1080  API-\uc0\u1090 \uc0\u1077 \uc0\u1089 \uc0\u1090 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1077 \uc0\u1084  conversational \uc0\u1080  workflow automation agents, \uc0\u1074 \uc0\u1082 \uc0\u1083 \uc0\u1102 \uc0\u1095 \uc0\u1072 \uc0\u1103  \uc0\u1087 \uc0\u1072 \uc0\u1081 \uc0\u1087 \uc0\u1083 \uc0\u1072 \uc0\u1081 \uc0\u1085 \uc0\u1099  \uc0\u1089 \uc0\u1091 \uc0\u1084 \uc0\u1084 \uc0\u1072 \uc0\u1088 \uc0\u1080 \uc0\u1079 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1080  Google Meet, \uc0\u1095 \uc0\u1090 \uc0\u1086  \uc0\u1089 \uc0\u1086 \uc0\u1082 \uc0\u1088 \uc0\u1072 \uc0\u1090 \uc0\u1080 \uc0\u1083 \uc0\u1086  \uc0\u1087 \uc0\u1091 \uc0\u1090 \uc0\u1100  \uc0\u1086 \uc0\u1090  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1090 \uc0\u1086 \uc0\u1090 \uc0\u1080 \uc0\u1087 \uc0\u1072  \uc0\u1076 \uc0\u1086  production \uc0\u1085 \uc0\u1072  40%.{\line}* \uc0\u1056 \uc0\u1072 \uc0\u1079 \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1072 \uc0\u1090 \uc0\u1099 \uc0\u1074 \uc0\u1072 \uc0\u1083  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1077 \uc0\u1088 \uc0\u1082 \uc0\u1080  \uc0\u1082 \uc0\u1072 \uc0\u1095 \uc0\u1077 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1072  \uc0\u1076 \uc0\u1072 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1093  \uc0\u1080  \uc0\u1085 \uc0\u1072 \uc0\u1075 \uc0\u1088 \uc0\u1091 \uc0\u1079 \uc0\u1086 \uc0\u1095 \uc0\u1085 \uc0\u1099 \uc0\u1077  \uc0\u1090 \uc0\u1077 \uc0\u1089 \uc0\u1090 \uc0\u1099  \uc0\u1076 \uc0\u1083 \uc0\u1103  fine-tuned M3 embedding models, \uc0\u1087 \uc0\u1086 \uc0\u1076 \uc0\u1090 \uc0\u1074 \uc0\u1077 \uc0\u1088 \uc0\u1076 \uc0\u1080 \uc0\u1074  \uc0\u1086 \uc0\u1082 \uc0\u1086 \uc0\u1083 \uc0\u1086  90% \uc0\u1090 \uc0\u1086 \uc0\u1095 \uc0\u1085 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1080  \uc0\u1087 \uc0\u1086 \uc0\u1080 \uc0\u1089 \uc0\u1082 \uc0\u1072  \uc0\u1085 \uc0\u1072  \uc0\u1082 \uc0\u1083 \uc0\u1080 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1089 \uc0\u1082 \uc0\u1080 \uc0\u1093  \uc0\u1076 \uc0\u1072 \uc0\u1090 \uc0\u1072 \uc0\u1089 \uc0\u1077 \uc0\u1090 \uc0\u1072 \uc0\u1093 .{\line}* \uc0\u1047 \uc0\u1072 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1083  \uc0\u1084 \uc0\u1085 \uc0\u1086 \uc0\u1075 \uc0\u1086 \uc0\u1095 \uc0\u1072 \uc0\u1089 \uc0\u1086 \uc0\u1074 \uc0\u1099 \uc0\u1077  \uc0\u1088 \uc0\u1091 \uc0\u1095 \uc0\u1085 \uc0\u1099 \uc0\u1077  \uc0\u1072 \uc0\u1085 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1090 \uc0\u1080 \uc0\u1095 \uc0\u1077 \uc0\u1089 \uc0\u1082 \uc0\u1080 \uc0\u1077  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1094 \uc0\u1077 \uc0\u1089 \uc0\u1089 \uc0\u1099  \uc0\u1076 \uc0\u1083 \uc0\u1103  \uc0\u1078 \uc0\u1077 \uc0\u1083 \uc0\u1077 \uc0\u1079 \uc0\u1085 \uc0\u1086 \uc0\u1076 \uc0\u1086 \uc0\u1088 \uc0\u1086 \uc0\u1078 \uc0\u1085 \uc0\u1086 \uc0\u1081  \uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1087 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1080  \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1085 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1100 \uc0\u1102  \uc0\u1072 \uc0\u1074 \uc0\u1090 \uc0\u1086 \uc0\u1084 \uc0\u1072 \uc0\u1090 \uc0\u1080 \uc0\u1079 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1084  \uc0\u1087 \uc0\u1072 \uc0\u1081 \uc0\u1087 \uc0\u1083 \uc0\u1072 \uc0\u1081 \uc0\u1085 \uc0\u1086 \uc0\u1084 , \uc0\u1082 \uc0\u1086 \uc0\u1090 \uc0\u1086 \uc0\u1088 \uc0\u1099 \uc0\u1081  \uc0\u1074 \uc0\u1099 \uc0\u1103 \uc0\u1074 \uc0\u1083 \uc0\u1103 \uc0\u1077 \uc0\u1090  \uc0\u1080  \uc0\u1083 \uc0\u1086 \uc0\u1082 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1079 \uc0\u1091 \uc0\u1077 \uc0\u1090  \uc0\u1076 \uc0\u1077 \uc0\u1092 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1099  \uc0\u1079 \uc0\u1072  \uc0\u1089 \uc0\u1077 \uc0\u1082 \uc0\u1091 \uc0\u1085 \uc0\u1076 \uc0\u1099 .{\line}* \uc0\u1050 \uc0\u1086 \uc0\u1085 \uc0\u1090 \uc0\u1088 \uc0\u1086 \uc0\u1083 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1083  \uc0\u1082 \uc0\u1086 \uc0\u1085 \uc0\u1089 \uc0\u1080 \uc0\u1089 \uc0\u1090 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1085 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1100  \uc0\u1076 \uc0\u1072 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1093  \uc0\u1080  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1080 \uc0\u1079 \uc0\u1074 \uc0\u1086 \uc0\u1076 \uc0\u1080 \uc0\u1090 \uc0\u1077 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1100  \uc0\u1079 \uc0\u1072 \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1089 \uc0\u1086 \uc0\u1074  \uc0\u1074  PostgreSQL \uc0\u1080  vector similarity search \uc0\u1089 \uc0\u1080 \uc0\u1089 \uc0\u1090 \uc0\u1077 \uc0\u1084 \uc0\u1072 \uc0\u1093 , \uc0\u1090 \uc0\u1072 \uc0\u1082 \uc0\u1080 \uc0\u1093  \uc0\u1082 \uc0\u1072 \uc0\u1082  Weaviate.{\line}* \uc0\u1055 \uc0\u1086 \uc0\u1076 \uc0\u1076 \uc0\u1077 \uc0\u1088 \uc0\u1078 \uc0\u1080 \uc0\u1074 \uc0\u1072 \uc0\u1083  \uc0\u1082 \uc0\u1072 \uc0\u1095 \uc0\u1077 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1086  \uc0\u1082 \uc0\u1086 \uc0\u1076 \uc0\u1072  \uc0\u1080  \uc0\u1080 \uc0\u1085 \uc0\u1078 \uc0\u1077 \uc0\u1085 \uc0\u1077 \uc0\u1088 \uc0\u1085 \uc0\u1099 \uc0\u1077  \uc0\u1089 \uc0\u1090 \uc0\u1072 \uc0\u1085 \uc0\u1076 \uc0\u1072 \uc0\u1088 \uc0\u1090 \uc0\u1099  \uc0\u1095 \uc0\u1077 \uc0\u1088 \uc0\u1077 \uc0\u1079  code review \uc0\u1080  pair programming, \uc0\u1089 \uc0\u1086 \uc0\u1082 \uc0\u1088 \uc0\u1072 \uc0\u1090 \uc0\u1080 \uc0\u1074  \uc0\u1074 \uc0\u1088 \uc0\u1077 \uc0\u1084 \uc0\u1103  \uc0\u1086 \uc0\u1085 \uc0\u1073 \uc0\u1086 \uc0\u1088 \uc0\u1076 \uc0\u1080 \uc0\u1085 \uc0\u1075 \uc0\u1072  junior-\uc0\u1080 \uc0\u1085 \uc0\u1078 \uc0\u1077 \uc0\u1085 \uc0\u1077 \uc0\u1088 \uc0\u1086 \uc0\u1074  \uc0\u1085 \uc0\u1072  50% \uc0\u1080  \uc0\u1087 \uc0\u1086 \uc0\u1074 \uc0\u1099 \uc0\u1089 \uc0\u1080 \uc0\u1074  acceptance rate pull request\uc0\u8217 \uc0\u1086 \uc0\u1074  \uc0\u1087 \uc0\u1088 \uc0\u1080 \uc0\u1084 \uc0\u1077 \uc0\u1088 \uc0\u1085 \uc0\u1086  \uc0\u1085 \uc0\u1072  35%.{\line}* \uc0\u1055 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1086 \uc0\u1076 \uc0\u1080 \uc0\u1083  \uc0\u1082 \uc0\u1086 \uc0\u1088 \uc0\u1087 \uc0\u1086 \uc0\u1088 \uc0\u1072 \uc0\u1090 \uc0\u1080 \uc0\u1074 \uc0\u1085 \uc0\u1099 \uc0\u1077  \uc0\u1074 \uc0\u1086 \uc0\u1088 \uc0\u1082 \uc0\u1096 \uc0\u1086 \uc0\u1087 \uc0\u1099  \uc0\u1087 \uc0\u1086  LLM, prompt engineering \uc0\u1080  \uc0\u1074 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1076 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1080  agent design \uc0\u1076 \uc0\u1083 \uc0\u1103  \uc0\u1073 \uc0\u1086 \uc0\u1083 \uc0\u1077 \uc0\u1077  \uc0\u1095 \uc0\u1077 \uc0\u1084  50 \uc0\u1089 \uc0\u1086 \uc0\u1090 \uc0\u1088 \uc0\u1091 \uc0\u1076 \uc0\u1085 \uc0\u1080 \uc0\u1082 \uc0\u1086 \uc0\u1074  enterprise-\uc0\u1082 \uc0\u1083 \uc0\u1080 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1086 \uc0\u1074 .{\line}* \uc0\u1055 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1086 \uc0\u1076 \uc0\u1080 \uc0\u1083  \uc0\u1085 \uc0\u1072 \uc0\u1075 \uc0\u1088 \uc0\u1091 \uc0\u1079 \uc0\u1086 \uc0\u1095 \uc0\u1085 \uc0\u1086 \uc0\u1077  \uc0\u1080  performance-\uc0\u1090 \uc0\u1077 \uc0\u1089 \uc0\u1090 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1089  \uc0\u1080 \uc0\u1089 \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1100 \uc0\u1079 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1077 \uc0\u1084  Python \uc0\u1080  Locust \uc0\u1076 \uc0\u1083 \uc0\u1103  high-traffic hackathon-\uc0\u1088 \uc0\u1077 \uc0\u1096 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103 : \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1077 \uc0\u1088 \uc0\u1103 \uc0\u1083  \uc0\u1089 \uc0\u1090 \uc0\u1072 \uc0\u1073 \uc0\u1080 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1100  \uc0\u1089 \uc0\u1080 \uc0\u1089 \uc0\u1090 \uc0\u1077 \uc0\u1084 \uc0\u1099 , \uc0\u1080 \uc0\u1079 \uc0\u1084 \uc0\u1077 \uc0\u1088 \uc0\u1103 \uc0\u1083  latency \uc0\u1080  \uc0\u1074 \uc0\u1099 \uc0\u1103 \uc0\u1074 \uc0\u1083 \uc0\u1103 \uc0\u1083  backend bottlenecks \uc0\u1087 \uc0\u1088 \uc0\u1080  \uc0\u1087 \uc0\u1080 \uc0\u1082 \uc0\u1086 \uc0\u1074 \uc0\u1086 \uc0\u1081  \uc0\u1089 \uc0\u1080 \uc0\u1084 \uc0\u1091 \uc0\u1083 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1085 \uc0\u1086 \uc0\u1081  \uc0\u1085 \uc0\u1072 \uc0\u1075 \uc0\u1088 \uc0\u1091 \uc0\u1079 \uc0\u1082 \uc0\u1077 .}

\cell\row

