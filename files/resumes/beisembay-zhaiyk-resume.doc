\uc0\u1057 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1103 \uc0\u1073 \uc0\u1088 \uc0\u1100  2019 \emdash  \uc0\u1048 \uc0\u1102 \uc0\u1085 \uc0\u1100  2023
\line 3 \uc0\u1075 \uc0\u1086 \uc0\u1076 \uc0\u1072 \uc0\u160 10 \uc0\u1084 \uc0\u1077 \uc0\u1089 \uc0\u1103 \uc0\u1094 \uc0\u1077 \uc0\u1074 }\cell

