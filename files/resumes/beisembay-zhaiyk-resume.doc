{\cb5\chcfpat5\chcbpat5 BPMN}  {\cb5\chcfpat5\chcbpat5 SQL}  {\cb5\chcfpat5\chcbpat5 ORACLE}  {\cb5\chcfpat5\chcbpat5 SOAP}  {\cb5\chcfpat5\chcbpat5 MS\~Word}  {\cb5\chcfpat5\chcbpat5 MS\~Excel}  {\cb5\chcfpat5\chcbpat5 \uc0\u1040 \uc0\u1085 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1090 \uc0\u1080 \uc0\u1082 \uc0\u1072 }  {\cb5\chcfpat5\chcbpat5 XML}  {\cb5\chcfpat5\chcbpat5 \uc0\u1041 \uc0\u1072 \uc0\u1079 \uc0\u1072 \~\uc0\u1076 \uc0\u1072 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1093 :\~Oracle}  {\cb5\chcfpat5\chcbpat5 \uc0\u1044 \uc0\u1077 \uc0\u1083 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1103 \~\uc0\u1087 \uc0\u1077 \uc0\u1088 \uc0\u1077 \uc0\u1087 \uc0\u1080 \uc0\u1089 \uc0\u1082 \uc0\u1072 }  {\cb5\chcfpat5\chcbpat5 Intellij\~IDEA}  {\cb5\chcfpat5\chcbpat5 \uc0\u1058 \uc0\u1077 \uc0\u1089 \uc0\u1090 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1077 \~\uc0\u1073 \uc0\u1072 \uc0\u1079 \~\uc0\u1076 \uc0\u1072 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1093 }  {\cb5\chcfpat5\chcbpat5 \uc0\u1040 \uc0\u1085 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1079 \~\uc0\u1090 \uc0\u1088 \uc0\u1077 \uc0\u1073 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1081 }  {\cb5\chcfpat5\chcbpat5 API}  {\cb5\chcfpat5\chcbpat5 Postman}  {\cb5\chcfpat5\chcbpat5 Agile}  {\cb5\chcfpat5\chcbpat5 Kanban}  {\cb5\chcfpat5\chcbpat5 Scrum}  {\cb5\chcfpat5\chcbpat5 Git}  {\cb5\chcfpat5\chcbpat5 Agile\~Project\~Management}  {\cb5\chcfpat5\chcbpat5 XML/XSD/JSON}  {\cb5\chcfpat5\chcbpat5 \uc0\u1048 \uc0\u1085 \uc0\u1090 \uc0\u1077 \uc0\u1075 \uc0\u1088 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1103 \~\uc0\u1087 \uc0\u1088 \uc0\u1080 \uc0\u1083 \uc0\u1086 \uc0\u1078 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1081 }  {\cb5\chcfpat5\chcbpat5 Confluence}  {\cb5\chcfpat5\chcbpat5 Jira}  {\cb5\chcfpat5\chcbpat5 \uc0\u1056 \uc0\u1072 \uc0\u1079 \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1082 \uc0\u1072 \~\uc0\u1090 \uc0\u1077 \uc0\u1093 \uc0\u1085 \uc0\u1080 \uc0\u1095 \uc0\u1077 \uc0\u1089 \uc0\u1082 \uc0\u1080 \uc0\u1093 \~\uc0\u1079 \uc0\u1072 \uc0\u1076 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1081 }  {\cb5\chcfpat5\chcbpat5 \uc0\u1057 \uc0\u1080 \uc0\u1089 \uc0\u1090 \uc0\u1077 \uc0\u1084 \uc0\u1085 \uc0\u1099 \uc0\u1081 \~\uc0\u1072 \uc0\u1085 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1079 }  {\cb5\chcfpat5\chcbpat5 UML}}\cell\row

