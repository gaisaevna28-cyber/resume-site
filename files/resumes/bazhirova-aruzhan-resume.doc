{\fs18 \uc0\u1048 \uc0\u1085 \uc0\u1092 \uc0\u1086 \uc0\u1088 \uc0\u1084 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1086 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1077  \uc0\u1090 \uc0\u1077 \uc0\u1093 \uc0\u1085 \uc0\u1086 \uc0\u1083 \uc0\u1086 \uc0\u1075 \uc0\u1080 \uc0\u1080 , \uc0\u1089 \uc0\u1080 \uc0\u1089 \uc0\u1090 \uc0\u1077 \uc0\u1084 \uc0\u1085 \uc0\u1072 \uc0\u1103  \uc0\u1080 \uc0\u1085 \uc0\u1090 \uc0\u1077 \uc0\u1075 \uc0\u1088 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1103 , \uc0\u1080 \uc0\u1085 \uc0\u1090 \uc0\u1077 \uc0\u1088 \uc0\u1085 \uc0\u1077 \uc0\u1090 }
\par\li300{
{\fs18 \uc0\u8226  \uc0\u1056 \uc0\u1072 \uc0\u1079 \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1082 \uc0\u1072  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1075 \uc0\u1088 \uc0\u1072 \uc0\u1084 \uc0\u1084 \uc0\u1085 \uc0\u1086 \uc0\u1075 \uc0\u1086  \uc0\u1086 \uc0\u1073 \uc0\u1077 \uc0\u1089 \uc0\u1087 \uc0\u1077 \uc0\u1095 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103 }
}
\par

\pard\intbl\itap1\sl280\sb60\sa60{\fs24 Scrum-\uc0\u1084 \uc0\u1072 \uc0\u1089 \uc0\u1090 \uc0\u1077 \uc0\u1088  / \uc0\u1041 \uc0\u1080 \uc0\u1079 \uc0\u1085 \uc0\u1077 \uc0\u1089 -\uc0\u1072 \uc0\u1085 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1090 \uc0\u1080 \uc0\u1082 \par}

\pard\intbl\itap1\sl260\sa60{\fs18 \uc0\u1057 \uc0\u1086 \uc0\u1074 \uc0\u1084 \uc0\u1077 \uc0\u1097 \uc0\u1072 \uc0\u1102  \uc0\u1088 \uc0\u1086 \uc0\u1083 \uc0\u1080  Scrum-\uc0\u1084 \uc0\u1072 \uc0\u1089 \uc0\u1090 \uc0\u1077 \uc0\u1088 \uc0\u1072  \uc0\u1080  \uc0\u1073 \uc0\u1080 \uc0\u1079 \uc0\u1085 \uc0\u1077 \uc0\u1089 -\uc0\u1072 \uc0\u1085 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1090 \uc0\u1080 \uc0\u1082 \uc0\u1072  \uc0\u1074  \uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1087 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1080  \uc0\u8212  \uc0\u1088 \uc0\u1072 \uc0\u1079 \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1095 \uc0\u1080 \uc0\u1082 \uc0\u1077  \uc0\u1055 \uc0\u1054 , \uc0\u1089 \uc0\u1072 \uc0\u1081 \uc0\u1090 \uc0\u1086 \uc0\u1074  \uc0\u1080  \uc0\u1087 \uc0\u1083 \uc0\u1072 \uc0\u1090 \uc0\u1092 \uc0\u1086 \uc0\u1088 \uc0\u1084  \uc0\u1076 \uc0\u1083 \uc0\u1103  \uc0\u1072 \uc0\u1074 \uc0\u1090 \uc0\u1086 \uc0\u1084 \uc0\u1072 \uc0\u1090 \uc0\u1080 \uc0\u1079 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1080  \uc0\u1073 \uc0\u1080 \uc0\u1079 \uc0\u1085 \uc0\u1077 \uc0\u1089 -\uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1094 \uc0\u1077 \uc0\u1089 \uc0\u1089 \uc0\u1086 \uc0\u1074 .{\line}{\line}\uc0\u1050 \uc0\u1083 \uc0\u1102 \uc0\u1095 \uc0\u1077 \uc0\u1074 \uc0\u1099 \uc0\u1077  \uc0\u1088 \uc0\u1077 \uc0\u1079 \uc0\u1091 \uc0\u1083 \uc0\u1100 \uc0\u1090 \uc0\u1072 \uc0\u1090 \uc0\u1099 :{\line}- \uc0\u1057  \uc0\u1085 \uc0\u1091 \uc0\u1083 \uc0\u1103  \uc0\u1088 \uc0\u1072 \uc0\u1079 \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1072 \uc0\u1083 \uc0\u1072  \uc0\u1080  \uc0\u1079 \uc0\u1072 \uc0\u1097 \uc0\u1080 \uc0\u1090 \uc0\u1080 \uc0\u1083 \uc0\u1072  \uc0\u1087 \uc0\u1077 \uc0\u1088 \uc0\u1077 \uc0\u1076  \uc0\u1088 \uc0\u1091 \uc0\u1082 \uc0\u1086 \uc0\u1074 \uc0\u1086 \uc0\u1076 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1086 \uc0\u1084  \uc0\u1084 \uc0\u1077 \uc0\u1090 \uc0\u1086 \uc0\u1076 \uc0\u1086 \uc0\u1083 \uc0\u1086 \uc0\u1075 \uc0\u1080 \uc0\u1102  Scrum (\uc0\u171 \uc0\u1055 \uc0\u1086 \uc0\u1083 \uc0\u1086 \uc0\u1078 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1086  \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1077  \uc0\u1074  Scrum\uc0\u187 ), \uc0\u1072 \uc0\u1076 \uc0\u1072 \uc0\u1087 \uc0\u1090 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1085 \uc0\u1091 \uc0\u1102  \uc0\u1087 \uc0\u1086 \uc0\u1076  IT- \uc0\u1080  \uc0\u1085 \uc0\u1077 -IT-\uc0\u1086 \uc0\u1090 \uc0\u1076 \uc0\u1077 \uc0\u1083 \uc0\u1099  \uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1087 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1080 .{\line}- \uc0\u1047 \uc0\u1072  7 \uc0\u1084 \uc0\u1077 \uc0\u1089 \uc0\u1103 \uc0\u1094 \uc0\u1077 \uc0\u1074  \uc0\u1084 \uc0\u1072 \uc0\u1089 \uc0\u1096 \uc0\u1090 \uc0\u1072 \uc0\u1073 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1083 \uc0\u1072  \uc0\u1087 \uc0\u1088 \uc0\u1072 \uc0\u1082 \uc0\u1090 \uc0\u1080 \uc0\u1082 \uc0\u1091  \uc0\u1089  9 \uc0\u1076 \uc0\u1086  15 \uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1072 \uc0\u1085 \uc0\u1076  \uc0\u1080  \uc0\u1089  ~30 \uc0\u1076 \uc0\u1086  ~60 \uc0\u1095 \uc0\u1077 \uc0\u1083 \uc0\u1086 \uc0\u1074 \uc0\u1077 \uc0\u1082 ; \uc0\u1086 \uc0\u1073 \uc0\u1091 \uc0\u1095 \uc0\u1080 \uc0\u1083 \uc0\u1072  \uc0\u1084 \uc0\u1077 \uc0\u1090 \uc0\u1086 \uc0\u1076 \uc0\u1086 \uc0\u1083 \uc0\u1086 \uc0\u1075 \uc0\u1080 \uc0\u1080  ~30 \uc0\u1089 \uc0\u1086 \uc0\u1090 \uc0\u1088 \uc0\u1091 \uc0\u1076 \uc0\u1085 \uc0\u1080 \uc0\u1082 \uc0\u1086 \uc0\u1074  \uc0\u1074  \uc0\u1087 \uc0\u1077 \uc0\u1088 \uc0\u1074 \uc0\u1099 \uc0\u1081  \uc0\u1084 \uc0\u1077 \uc0\u1089 \uc0\u1103 \uc0\u1094  \uc0\u1074 \uc0\u1085 \uc0\u1077 \uc0\u1076 \uc0\u1088 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1080  \uc0\u1077 \uc0\u1097 \uc0\u1105  15+ \uc0\u1085 \uc0\u1086 \uc0\u1074 \uc0\u1099 \uc0\u1093  \uc0\u1089 \uc0\u1086 \uc0\u1090 \uc0\u1088 \uc0\u1091 \uc0\u1076 \uc0\u1085 \uc0\u1080 \uc0\u1082 \uc0\u1086 \uc0\u1074  \uc0\u1074 \uc0\u1087 \uc0\u1086 \uc0\u1089 \uc0\u1083 \uc0\u1077 \uc0\u1076 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1080 \uc0\u1080  \uc0\u8212  \uc0\u1083 \uc0\u1080 \uc0\u1095 \uc0\u1085 \uc0\u1086 , \uc0\u1085 \uc0\u1072  \uc0\u1080 \uc0\u1093  \uc0\u1088 \uc0\u1077 \uc0\u1072 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1099 \uc0\u1093  \uc0\u1079 \uc0\u1072 \uc0\u1076 \uc0\u1072 \uc0\u1095 \uc0\u1072 \uc0\u1093 .{\line}- \uc0\u1055 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1077 \uc0\u1083 \uc0\u1072  140+ \uc0\u1089 \uc0\u1087 \uc0\u1088 \uc0\u1080 \uc0\u1085 \uc0\u1090 \uc0\u1086 \uc0\u1074 : 3 000+ \uc0\u1079 \uc0\u1072 \uc0\u1076 \uc0\u1072 \uc0\u1095  \uc0\u1079 \uc0\u1072 \uc0\u1082 \uc0\u1088 \uc0\u1099 \uc0\u1090 \uc0\u1086 , 13 000+ story points \uc0\u1086 \uc0\u1094 \uc0\u1077 \uc0\u1085 \uc0\u1077 \uc0\u1085 \uc0\u1086  \uc0\u1087 \uc0\u1086  250+ \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1072 \uc0\u1084  \uc0\u1080  \uc0\u1085 \uc0\u1072 \uc0\u1087 \uc0\u1088 \uc0\u1072 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103 \uc0\u1084 ; \uc0\u1074  \uc0\u1089 \uc0\u1080 \uc0\u1089 \uc0\u1090 \uc0\u1077 \uc0\u1084 \uc0\u1077  \uc0\u1085 \uc0\u1072 \uc0\u1082 \uc0\u1086 \uc0\u1087 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1086  470+ daily-\uc0\u1074 \uc0\u1089 \uc0\u1090 \uc0\u1088 \uc0\u1077 \uc0\u1095  \uc0\u1086 \uc0\u1090  32 \uc0\u1089 \uc0\u1086 \uc0\u1090 \uc0\u1088 \uc0\u1091 \uc0\u1076 \uc0\u1085 \uc0\u1080 \uc0\u1082 \uc0\u1086 \uc0\u1074 .{\line}- \uc0\u1057 \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1083 \uc0\u1072  \uc0\u1080  \uc0\u1088 \uc0\u1072 \uc0\u1079 \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1072 \uc0\u1083 \uc0\u1072  \uc0\u1089  \uc0\u1087 \uc0\u1086 \uc0\u1084 \uc0\u1086 \uc0\u1097 \uc0\u1100 \uc0\u1102  AI-\uc0\u1080 \uc0\u1085 \uc0\u1089 \uc0\u1090 \uc0\u1088 \uc0\u1091 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1086 \uc0\u1074  \uc0\u1088 \uc0\u1072 \uc0\u1079 \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1082 \uc0\u1080  \uc0\u1087 \uc0\u1083 \uc0\u1072 \uc0\u1090 \uc0\u1092 \uc0\u1086 \uc0\u1088 \uc0\u1084 \uc0\u1091  \uc0\u171 People Intelligence\uc0\u187  \uc0\u8212  \uc0\u1074 \uc0\u1077 \uc0\u1073 -\uc0\u1076 \uc0\u1072 \uc0\u1096 \uc0\u1073 \uc0\u1086 \uc0\u1088 \uc0\u1076  \uc0\u1072 \uc0\u1085 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1090 \uc0\u1080 \uc0\u1082 \uc0\u1080  \uc0\u1087 \uc0\u1086  \uc0\u1074 \uc0\u1089 \uc0\u1077 \uc0\u1084  16 scrum-\uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1072 \uc0\u1085 \uc0\u1076 \uc0\u1072 \uc0\u1084  \uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1087 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1080  \uc0\u1087 \uc0\u1086 \uc0\u1074 \uc0\u1077 \uc0\u1088 \uc0\u1093  \uc0\u1076 \uc0\u1072 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1093  Bitrix24 (\uc0\u1080 \uc0\u1085 \uc0\u1090 \uc0\u1077 \uc0\u1075 \uc0\u1088 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1103  \uc0\u1095 \uc0\u1077 \uc0\u1088 \uc0\u1077 \uc0\u1079  API, \uc0\u1072 \uc0\u1074 \uc0\u1090 \uc0\u1086 \uc0\u1084 \uc0\u1072 \uc0\u1090 \uc0\u1080 \uc0\u1095 \uc0\u1077 \uc0\u1089 \uc0\u1082 \uc0\u1072 \uc0\u1103  \uc0\u1092 \uc0\u1086 \uc0\u1085 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1103  \uc0\u1089 \uc0\u1080 \uc0\u1085 \uc0\u1093 \uc0\u1088 \uc0\u1086 \uc0\u1085 \uc0\u1080 \uc0\u1079 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1103 ); \uc0\u1079 \uc0\u1072 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1083 \uc0\u1072  \uc0\u1077 \uc0\u1078 \uc0\u1077 \uc0\u1085 \uc0\u1077 \uc0\u1076 \uc0\u1077 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1099 \uc0\u1081  \uc0\u1088 \uc0\u1091 \uc0\u1095 \uc0\u1085 \uc0\u1086 \uc0\u1081  \uc0\u1089 \uc0\u1073 \uc0\u1086 \uc0\u1088  \uc0\u1076 \uc0\u1072 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1093  \uc0\u1074  Word-\uc0\u1086 \uc0\u1090 \uc0\u1095 \uc0\u1105 \uc0\u1090 .{\line}- \uc0\u1055 \uc0\u1083 \uc0\u1072 \uc0\u1090 \uc0\u1092 \uc0\u1086 \uc0\u1088 \uc0\u1084 \uc0\u1072  \uc0\u1089 \uc0\u1095 \uc0\u1080 \uc0\u1090 \uc0\u1072 \uc0\u1077 \uc0\u1090  \uc0\u1088 \uc0\u1080 \uc0\u1089 \uc0\u1082  \uc0\u1087 \uc0\u1086  \uc0\u1082 \uc0\u1072 \uc0\u1078 \uc0\u1076 \uc0\u1086 \uc0\u1084 \uc0\u1091  \uc0\u1089 \uc0\u1086 \uc0\u1090 \uc0\u1088 \uc0\u1091 \uc0\u1076 \uc0\u1085 \uc0\u1080 \uc0\u1082 \uc0\u1091  \uc0\u1085 \uc0\u1072  \uc0\u1086 \uc0\u1089 \uc0\u1085 \uc0\u1086 \uc0\u1074 \uc0\u1077  \uc0\u1085 \uc0\u1077 \uc0\u1089 \uc0\u1082 \uc0\u1086 \uc0\u1083 \uc0\u1100 \uc0\u1082 \uc0\u1080 \uc0\u1093  \uc0\u1089 \uc0\u1080 \uc0\u1075 \uc0\u1085 \uc0\u1072 \uc0\u1083 \uc0\u1086 \uc0\u1074  (cycle time, WIP, blocker rate, spillover), \uc0\u1087 \uc0\u1086 \uc0\u1082 \uc0\u1072 \uc0\u1079 \uc0\u1099 \uc0\u1074 \uc0\u1072 \uc0\u1077 \uc0\u1090  \uc0\u1082 \uc0\u1086 \uc0\u1085 \uc0\u1094 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1088 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1102  \uc0\u1085 \uc0\u1072 \uc0\u1075 \uc0\u1088 \uc0\u1091 \uc0\u1079 \uc0\u1082 \uc0\u1080  \uc0\u1087 \uc0\u1086  \uc0\u1090 \uc0\u1080 \uc0\u1082 \uc0\u1077 \uc0\u1090 \uc0\u1072 \uc0\u1084  (\uc0\u171 bus factor\uc0\u187 ), \uc0\u1085 \uc0\u1077 \uc0\u1076 \uc0\u1077 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1099 \uc0\u1077  \uc0\u1090 \uc0\u1088 \uc0\u1077 \uc0\u1085 \uc0\u1076 \uc0\u1099  \uc0\u1086 \uc0\u1095 \uc0\u1077 \uc0\u1088 \uc0\u1077 \uc0\u1076 \uc0\u1080  \uc0\u1079 \uc0\u1072 \uc0\u1076 \uc0\u1072 \uc0\u1095 , SLA \uc0\u1080  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1089 \uc0\u1088 \uc0\u1086 \uc0\u1095 \uc0\u1082 \uc0\u1080 , \uc0\u1074 \uc0\u1082 \uc0\u1083 \uc0\u1102 \uc0\u1095 \uc0\u1072 \uc0\u1077 \uc0\u1090  \uc0\u1101 \uc0\u1082 \uc0\u1089 \uc0\u1087 \uc0\u1086 \uc0\u1088 \uc0\u1090  \uc0\u1086 \uc0\u1090 \uc0\u1095 \uc0\u1105 \uc0\u1090 \uc0\u1086 \uc0\u1074  \uc0\u1074  Excel \uc0\u1080  \uc0\u1084 \uc0\u1086 \uc0\u1076 \uc0\u1091 \uc0\u1083 \uc0\u1100  \uc0\u1079 \uc0\u1072 \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1089 \uc0\u1086 \uc0\u1074  \uc0\u1082  \uc0\u1076 \uc0\u1072 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1084  \uc0\u1085 \uc0\u1072  \uc0\u1077 \uc0\u1089 \uc0\u1090 \uc0\u1077 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1077 \uc0\u1085 \uc0\u1085 \uc0\u1086 \uc0\u1084  \uc0\u1103 \uc0\u1079 \uc0\u1099 \uc0\u1082 \uc0\u1077 .{\line}- \uc0\u1042 \uc0\u1085 \uc0\u1077 \uc0\u1076 \uc0\u1088 \uc0\u1080 \uc0\u1083 \uc0\u1072  \uc0\u1089 \uc0\u1080 \uc0\u1089 \uc0\u1090 \uc0\u1077 \uc0\u1084 \uc0\u1091  \uc0\u1088 \uc0\u1072 \uc0\u1085 \uc0\u1085 \uc0\u1077 \uc0\u1075 \uc0\u1086  \uc0\u1074 \uc0\u1099 \uc0\u1103 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1088 \uc0\u1080 \uc0\u1089 \uc0\u1082 \uc0\u1072  \uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1072 \uc0\u1085 \uc0\u1076 \uc0\u1099  \uc0\u1085 \uc0\u1072  \uc0\u1086 \uc0\u1089 \uc0\u1085 \uc0\u1086 \uc0\u1074 \uc0\u1077  4 \uc0\u1085 \uc0\u1077 \uc0\u1079 \uc0\u1072 \uc0\u1074 \uc0\u1080 \uc0\u1089 \uc0\u1080 \uc0\u1084 \uc0\u1099 \uc0\u1093  \uc0\u1089 \uc0\u1080 \uc0\u1075 \uc0\u1085 \uc0\u1072 \uc0\u1083 \uc0\u1086 \uc0\u1074  (\uc0\u1089 \uc0\u1082 \uc0\u1086 \uc0\u1088 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1100  \uc0\u1087 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1072 \uc0\u1074 \uc0\u1082 \uc0\u1080  story points, \uc0\u1076 \uc0\u1083 \uc0\u1080 \uc0\u1090 \uc0\u1077 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1100  \uc0\u1094 \uc0\u1080 \uc0\u1082 \uc0\u1083 \uc0\u1072  \uc0\u1079 \uc0\u1072 \uc0\u1076 \uc0\u1072 \uc0\u1095 \uc0\u1080 , \uc0\u1076 \uc0\u1086 \uc0\u1083 \uc0\u1103  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1089 \uc0\u1088 \uc0\u1086 \uc0\u1095 \uc0\u1077 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1093  \uc0\u1079 \uc0\u1072 \uc0\u1076 \uc0\u1072 \uc0\u1095 , \uc0\u1087 \uc0\u1086 \uc0\u1074 \uc0\u1090 \uc0\u1086 \uc0\u1088 \uc0\u1103 \uc0\u1102 \uc0\u1097 \uc0\u1080 \uc0\u1077 \uc0\u1089 \uc0\u1103  \uc0\u1073 \uc0\u1083 \uc0\u1086 \uc0\u1082 \uc0\u1077 \uc0\u1088 \uc0\u1099 ) \uc0\u1089  \uc0\u1087 \uc0\u1088 \uc0\u1072 \uc0\u1074 \uc0\u1080 \uc0\u1083 \uc0\u1086 \uc0\u1084  \uc0\u171 3 \uc0\u1080 \uc0\u1079  4 \uc0\u1089 \uc0\u1080 \uc0\u1075 \uc0\u1085 \uc0\u1072 \uc0\u1083 \uc0\u1086 \uc0\u1074 \uc0\u187 .{\line}- \uc0\u1057 \uc0\u1086 \uc0\u1073 \uc0\u1080 \uc0\u1088 \uc0\u1072 \uc0\u1102  \uc0\u1080  \uc0\u1076 \uc0\u1086 \uc0\u1082 \uc0\u1091 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1080 \uc0\u1088 \uc0\u1091 \uc0\u1102  \uc0\u1073 \uc0\u1080 \uc0\u1079 \uc0\u1085 \uc0\u1077 \uc0\u1089 -\uc0\u1090 \uc0\u1088 \uc0\u1077 \uc0\u1073 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1103  (\uc0\u1058 \uc0\u1047 , user stories, \uc0\u1082 \uc0\u1088 \uc0\u1080 \uc0\u1090 \uc0\u1077 \uc0\u1088 \uc0\u1080 \uc0\u1080  \uc0\u1087 \uc0\u1088 \uc0\u1080 \uc0\u1105 \uc0\u1084 \uc0\u1082 \uc0\u1080 ) \uc0\u1086 \uc0\u1090  \uc0\u1079 \uc0\u1072 \uc0\u1082 \uc0\u1072 \uc0\u1079 \uc0\u1095 \uc0\u1080 \uc0\u1082 \uc0\u1086 \uc0\u1074  \uc0\u1080  \uc0\u1089 \uc0\u1090 \uc0\u1077 \uc0\u1081 \uc0\u1082 \uc0\u1093 \uc0\u1086 \uc0\u1083 \uc0\u1076 \uc0\u1077 \uc0\u1088 \uc0\u1086 \uc0\u1074 , \uc0\u1089 \uc0\u1086 \uc0\u1075 \uc0\u1083 \uc0\u1072 \uc0\u1089 \uc0\u1086 \uc0\u1074 \uc0\u1099 \uc0\u1074 \uc0\u1072 \uc0\u1102  \uc0\u1086 \uc0\u1078 \uc0\u1080 \uc0\u1076 \uc0\u1072 \uc0\u1077 \uc0\u1084 \uc0\u1099 \uc0\u1081  \uc0\u1088 \uc0\u1077 \uc0\u1079 \uc0\u1091 \uc0\u1083 \uc0\u1100 \uc0\u1090 \uc0\u1072 \uc0\u1090  \uc0\u1089  \uc0\u1086 \uc0\u1073 \uc0\u1077 \uc0\u1080 \uc0\u1084 \uc0\u1080  \uc0\u1089 \uc0\u1090 \uc0\u1086 \uc0\u1088 \uc0\u1086 \uc0\u1085 \uc0\u1072 \uc0\u1084 \uc0\u1080  \uc0\u1076 \uc0\u1086  \uc0\u1085 \uc0\u1072 \uc0\u1095 \uc0\u1072 \uc0\u1083 \uc0\u1072  \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1099  \uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1072 \uc0\u1085 \uc0\u1076 \uc0\u1099 .{\line}- \uc0\u1050 \uc0\u1091 \uc0\u1088 \uc0\u1080 \uc0\u1088 \uc0\u1091 \uc0\u1102  \uc0\u1074 \uc0\u1085 \uc0\u1077 \uc0\u1076 \uc0\u1088 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1094 \uc0\u1077 \uc0\u1089 \uc0\u1089 \uc0\u1086 \uc0\u1074  \uc0\u1085 \uc0\u1077  \uc0\u1090 \uc0\u1086 \uc0\u1083 \uc0\u1100 \uc0\u1082 \uc0\u1086  \uc0\u1074 \uc0\u1085 \uc0\u1091 \uc0\u1090 \uc0\u1088 \uc0\u1080  \uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1087 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1080 , \uc0\u1085 \uc0\u1086  \uc0\u1080  \uc0\u1074  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1072 \uc0\u1093  \uc0\u1085 \uc0\u1072  \uc0\u1089 \uc0\u1090 \uc0\u1086 \uc0\u1088 \uc0\u1086 \uc0\u1085 \uc0\u1077  \uc0\u1082 \uc0\u1083 \uc0\u1080 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1086 \uc0\u1074  \uc0\u8212  \uc0\u1089 \uc0\u1086 \uc0\u1075 \uc0\u1083 \uc0\u1072 \uc0\u1089 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1089 \uc0\u1088 \uc0\u1086 \uc0\u1082 \uc0\u1086 \uc0\u1074 , \uc0\u1086 \uc0\u1078 \uc0\u1080 \uc0\u1076 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1081  \uc0\u1080  \uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1084 \uc0\u1091 \uc0\u1085 \uc0\u1080 \uc0\u1082 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1103  \uc0\u1087 \uc0\u1086  \uc0\u1093 \uc0\u1086 \uc0\u1076 \uc0\u1091  \uc0\u1074 \uc0\u1085 \uc0\u1077 \uc0\u1076 \uc0\u1088 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103 .{\line}- \uc0\u1042 \uc0\u1077 \uc0\u1076 \uc0\u1091  \uc0\u1086 \uc0\u1095 \uc0\u1077 \uc0\u1088 \uc0\u1077 \uc0\u1076 \uc0\u1100  \uc0\u1079 \uc0\u1072 \uc0\u1103 \uc0\u1074 \uc0\u1086 \uc0\u1082  IT-\uc0\u1087 \uc0\u1086 \uc0\u1076 \uc0\u1076 \uc0\u1077 \uc0\u1088 \uc0\u1078 \uc0\u1082 \uc0\u1080 : 790+ \uc0\u1079 \uc0\u1072 \uc0\u1103 \uc0\u1074 \uc0\u1086 \uc0\u1082  \uc0\u1079 \uc0\u1072 \uc0\u1082 \uc0\u1088 \uc0\u1099 \uc0\u1090 \uc0\u1086 , 66,8% \uc0\u8212  \uc0\u1074  \uc0\u1089 \uc0\u1088 \uc0\u1086 \uc0\u1082  (SLA).{\line}{\line}\uc0\u1054 \uc0\u1073 \uc0\u1103 \uc0\u1079 \uc0\u1072 \uc0\u1085 \uc0\u1085 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1080 :{\line}- \uc0\u1057 \uc0\u1073 \uc0\u1086 \uc0\u1088 , \uc0\u1072 \uc0\u1085 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1079  \uc0\u1080  \uc0\u1076 \uc0\u1086 \uc0\u1082 \uc0\u1091 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1090 \uc0\u1088 \uc0\u1077 \uc0\u1073 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1081 ; \uc0\u1092 \uc0\u1086 \uc0\u1088 \uc0\u1084 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1080  \uc0\u1076 \uc0\u1077 \uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1087 \uc0\u1086 \uc0\u1079 \uc0\u1080 \uc0\u1094 \uc0\u1080 \uc0\u1103  \uc0\u1073 \uc0\u1101 \uc0\u1082 \uc0\u1083 \uc0\u1086 \uc0\u1075 \uc0\u1072 {\line}- \uc0\u1055 \uc0\u1083 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1089 \uc0\u1087 \uc0\u1088 \uc0\u1080 \uc0\u1085 \uc0\u1090 \uc0\u1086 \uc0\u1074 , \uc0\u1074 \uc0\u1077 \uc0\u1076 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  daily, \uc0\u1088 \uc0\u1077 \uc0\u1090 \uc0\u1088 \uc0\u1086 \uc0\u1089 \uc0\u1087 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1080 \uc0\u1074  \uc0\u1080  \uc0\u1088 \uc0\u1077 \uc0\u1074 \uc0\u1100 \uc0\u1102 {\line}- \uc0\u1052 \uc0\u1077 \uc0\u1090 \uc0\u1088 \uc0\u1080 \uc0\u1082 \uc0\u1080  \uc0\u1101 \uc0\u1092 \uc0\u1092 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1080 \uc0\u1074 \uc0\u1085 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1080  \uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1072 \uc0\u1085 \uc0\u1076  \uc0\u1080  \uc0\u1088 \uc0\u1077 \uc0\u1075 \uc0\u1091 \uc0\u1083 \uc0\u1103 \uc0\u1088 \uc0\u1085 \uc0\u1072 \uc0\u1103  \uc0\u1086 \uc0\u1090 \uc0\u1095 \uc0\u1105 \uc0\u1090 \uc0\u1085 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1100  \uc0\u1076 \uc0\u1083 \uc0\u1103  \uc0\u1088 \uc0\u1091 \uc0\u1082 \uc0\u1086 \uc0\u1074 \uc0\u1086 \uc0\u1076 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1072 {\line}- \uc0\u1042 \uc0\u1099 \uc0\u1103 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1080  \uc0\u1091 \uc0\u1089 \uc0\u1090 \uc0\u1088 \uc0\u1072 \uc0\u1085 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1073 \uc0\u1083 \uc0\u1086 \uc0\u1082 \uc0\u1077 \uc0\u1088 \uc0\u1086 \uc0\u1074 , \uc0\u1091 \uc0\u1087 \uc0\u1088 \uc0\u1072 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1079 \uc0\u1072 \uc0\u1074 \uc0\u1080 \uc0\u1089 \uc0\u1080 \uc0\u1084 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1103 \uc0\u1084 \uc0\u1080  \uc0\u1084 \uc0\u1077 \uc0\u1078 \uc0\u1076 \uc0\u1091  \uc0\u1079 \uc0\u1072 \uc0\u1076 \uc0\u1072 \uc0\u1095 \uc0\u1072 \uc0\u1084 \uc0\u1080 {\line}- \uc0\u1053 \uc0\u1072 \uc0\u1089 \uc0\u1090 \uc0\u1088 \uc0\u1086 \uc0\u1081 \uc0\u1082 \uc0\u1072  Bitrix24/Jira \uc0\u1080  \uc0\u1080 \uc0\u1085 \uc0\u1089 \uc0\u1090 \uc0\u1088 \uc0\u1091 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1086 \uc0\u1074  \uc0\u1089 \uc0\u1086 \uc0\u1074 \uc0\u1084 \uc0\u1077 \uc0\u1089 \uc0\u1090 \uc0\u1085 \uc0\u1086 \uc0\u1081  \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1099  \uc0\u1087 \uc0\u1086 \uc0\u1076  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1094 \uc0\u1077 \uc0\u1089 \uc0\u1089 \uc0\u1099  \uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1072 \uc0\u1085 \uc0\u1076 {\line}- \uc0\u1054 \uc0\u1073 \uc0\u1091 \uc0\u1095 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1089 \uc0\u1086 \uc0\u1090 \uc0\u1088 \uc0\u1091 \uc0\u1076 \uc0\u1085 \uc0\u1080 \uc0\u1082 \uc0\u1086 \uc0\u1074  \uc0\u1080  \uc0\u1089 \uc0\u1090 \uc0\u1077 \uc0\u1081 \uc0\u1082 \uc0\u1093 \uc0\u1086 \uc0\u1083 \uc0\u1076 \uc0\u1077 \uc0\u1088 \uc0\u1086 \uc0\u1074  Agile-\uc0\u1087 \uc0\u1088 \uc0\u1072 \uc0\u1082 \uc0\u1090 \uc0\u1080 \uc0\u1082 \uc0\u1072 \uc0\u1084  \uc0\u1080  \uc0\u1087 \uc0\u1088 \uc0\u1072 \uc0\u1074 \uc0\u1080 \uc0\u1083 \uc0\u1072 \uc0\u1084  \uc0\u1087 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1072 \uc0\u1085 \uc0\u1086 \uc0\u1074 \uc0\u1082 \uc0\u1080  \uc0\u1079 \uc0\u1072 \uc0\u1076 \uc0\u1072 \uc0\u1095 }

