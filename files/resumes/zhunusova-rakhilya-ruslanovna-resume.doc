\uc0\u1060 \uc0\u1086 \uc0\u1088 \uc0\u1084 \uc0\u1072 \uc0\u1090  \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1099 : \uc0\u1091 \uc0\u1076 \uc0\u1072 \uc0\u1083 \uc0\u1105 \uc0\u1085 \uc0\u1085 \uc0\u1086 , \uc0\u1075 \uc0\u1080 \uc0\u1073 \uc0\u1088 \uc0\u1080 \uc0\u1076 \par
