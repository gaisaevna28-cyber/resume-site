\uc0\u1062 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1088  \uc0\u1101 \uc0\u1083 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1088 \uc0\u1086 \uc0\u1085 \uc0\u1085 \uc0\u1086 \uc0\u1081  \uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1084 \uc0\u1077 \uc0\u1088 \uc0\u1094 \uc0\u1080 \uc0\u1080 , \uc0\u1058 \uc0\u1054 \uc0\u1054 
}\par

