\trowd\cellx9638\pard\intbl\itap1\sl260{\fs18 \uc0\u1052 \uc0\u1077 \uc0\u1085 \uc0\u1103  \uc0\u1079 \uc0\u1072 \uc0\u1080 \uc0\u1085 \uc0\u1090 \uc0\u1077 \uc0\u1088 \uc0\u1077 \uc0\u1089 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1083 \uc0\u1072  \uc0\u1074 \uc0\u1072 \uc0\u1096 \uc0\u1072  \uc0\u1074 \uc0\u1072 \uc0\u1082 \uc0\u1072 \uc0\u1085 \uc0\u1089 \uc0\u1080 \uc0\u1103 . \uc0\u1052 \uc0\u1086 \uc0\u1081  8-\uc0\u1083 \uc0\u1077 \uc0\u1090 \uc0\u1085 \uc0\u1080 \uc0\u1081  \uc0\u1086 \uc0\u1087 \uc0\u1099 \uc0\u1090  \uc0\u1074  Enterprise \uc0\u1048 \uc0\u1058 -\uc0\u1089 \uc0\u1088 \uc0\u1077 \uc0\u1076 \uc0\u1077  (ERG/BTS, \uc0\u1050 \uc0\u1052 \uc0\u1043  Digital) \uc0\u1085 \uc0\u1072  \uc0\u1089 \uc0\u1090 \uc0\u1099 \uc0\u1082 \uc0\u1077  \uc0\u1089 \uc0\u1080 \uc0\u1089 \uc0\u1090 \uc0\u1077 \uc0\u1084 \uc0\u1085 \uc0\u1086 \uc0\u1075 \uc0\u1086  \uc0\u1072 \uc0\u1085 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1079 \uc0\u1072  \uc0\u1080  \uc0\u1091 \uc0\u1087 \uc0\u1088 \uc0\u1072 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1074 \uc0\u1085 \uc0\u1091 \uc0\u1090 \uc0\u1088 \uc0\u1077 \uc0\u1085 \uc0\u1085 \uc0\u1080 \uc0\u1084 \uc0\u1080  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1076 \uc0\u1091 \uc0\u1082 \uc0\u1090 \uc0\u1072 \uc0\u1084 \uc0\u1080  \uc0\u1072 \uc0\u1074 \uc0\u1090 \uc0\u1086 \uc0\u1084 \uc0\u1072 \uc0\u1090 \uc0\u1080 \uc0\u1079 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1080  \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1085 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1100 \uc0\u1102  \uc0\u1089 \uc0\u1086 \uc0\u1086 \uc0\u1090 \uc0\u1074 \uc0\u1077 \uc0\u1090 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1091 \uc0\u1077 \uc0\u1090  \uc0\u1074 \uc0\u1072 \uc0\u1096 \uc0\u1080 \uc0\u1084  \uc0\u1090 \uc0\u1088 \uc0\u1077 \uc0\u1073 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1103 \uc0\u1084 .{\line}\uc0\u1055 \uc0\u1086 \uc0\u1095 \uc0\u1077 \uc0\u1084 \uc0\u1091  \uc0\u1084 \uc0\u1086 \uc0\u1081  \uc0\u1086 \uc0\u1087 \uc0\u1099 \uc0\u1090  \uc0\u1073 \uc0\u1091 \uc0\u1076 \uc0\u1077 \uc0\u1090  \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1077 \uc0\u1079 \uc0\u1077 \uc0\u1085  \uc0\u1074 \uc0\u1072 \uc0\u1096 \uc0\u1077 \uc0\u1081  \uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1072 \uc0\u1085 \uc0\u1076 \uc0\u1077 :{\line}\uc0\u8226  \uc0\u1054 \uc0\u1094 \uc0\u1080 \uc0\u1092 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1081  \uc0\u1088 \uc0\u1077 \uc0\u1079 \uc0\u1091 \uc0\u1083 \uc0\u1100 \uc0\u1090 \uc0\u1072 \uc0\u1090 : \uc0\u1057  \uc0\u1085 \uc0\u1091 \uc0\u1083 \uc0\u1103  \uc0\u1089 \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1083  \uc0\u1080  \uc0\u1083 \uc0\u1080 \uc0\u1076 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1083  \uc0\u1074 \uc0\u1085 \uc0\u1077 \uc0\u1076 \uc0\u1088 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  Enterprise-\uc0\u1087 \uc0\u1083 \uc0\u1072 \uc0\u1090 \uc0\u1092 \uc0\u1086 \uc0\u1088 \uc0\u1084 \uc0\u1099  \uc0\u1091 \uc0\u1087 \uc0\u1088 \uc0\u1072 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1076 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1091 \uc0\u1087 \uc0\u1072 \uc0\u1084 \uc0\u1080  (AccessControl), \uc0\u1082 \uc0\u1086 \uc0\u1090 \uc0\u1086 \uc0\u1088 \uc0\u1072 \uc0\u1103  \uc0\u1091 \uc0\u1089 \uc0\u1087 \uc0\u1077 \uc0\u1096 \uc0\u1085 \uc0\u1086  \uc0\u1086 \uc0\u1073 \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1072 \uc0\u1083 \uc0\u1072  \uc0\u1073 \uc0\u1086 \uc0\u1083 \uc0\u1077 \uc0\u1077  14 000 \uc0\u1079 \uc0\u1072 \uc0\u1103 \uc0\u1074 \uc0\u1086 \uc0\u1082  \uc0\u1080  \uc0\u1089 \uc0\u1086 \uc0\u1082 \uc0\u1088 \uc0\u1072 \uc0\u1090 \uc0\u1080 \uc0\u1083 \uc0\u1072  \uc0\u1074 \uc0\u1088 \uc0\u1077 \uc0\u1084 \uc0\u1103  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1094 \uc0\u1077 \uc0\u1089 \uc0\u1089 \uc0\u1072  \uc0\u1074  10 \uc0\u1088 \uc0\u1072 \uc0\u1079  (\uc0\u1089  25 \uc0\u1076 \uc0\u1086  2 \uc0\u1084 \uc0\u1080 \uc0\u1085 \uc0\u1091 \uc0\u1090 ).{\line}\uc0\u8226  \uc0\u1057 \uc0\u1080 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1099 \uc0\u1077  \uc0\u1093 \uc0\u1072 \uc0\u1088 \uc0\u1076 -\uc0\u1089 \uc0\u1082 \uc0\u1080 \uc0\u1083 \uc0\u1083 \uc0\u1099 : \uc0\u1040 \uc0\u1074 \uc0\u1090 \uc0\u1086 \uc0\u1084 \uc0\u1072 \uc0\u1090 \uc0\u1080 \uc0\u1079 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1083  end-to-end \uc0\u1094 \uc0\u1077 \uc0\u1087 \uc0\u1086 \uc0\u1095 \uc0\u1082 \uc0\u1080  IT-\uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1094 \uc0\u1077 \uc0\u1089 \uc0\u1089 \uc0\u1086 \uc0\u1074  \uc0\u1089  \uc0\u1087 \uc0\u1086 \uc0\u1084 \uc0\u1086 \uc0\u1097 \uc0\u1100 \uc0\u1102  Python (Django) \uc0\u1080  API-\uc0\u1086 \uc0\u1088 \uc0\u1082 \uc0\u1077 \uc0\u1089 \uc0\u1090 \uc0\u1088 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1080 , \uc0\u1087 \uc0\u1077 \uc0\u1088 \uc0\u1077 \uc0\u1074 \uc0\u1077 \uc0\u1076 \uc0\u1103  \uc0\u1088 \uc0\u1091 \uc0\u1090 \uc0\u1080 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1077  \uc0\u1086 \uc0\u1087 \uc0\u1077 \uc0\u1088 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1080  \uc0\u1074  1-\uc0\u1084 \uc0\u1080 \uc0\u1085 \uc0\u1091 \uc0\u1090 \uc0\u1085 \uc0\u1099 \uc0\u1077  \uc0\u1089 \uc0\u1082 \uc0\u1088 \uc0\u1080 \uc0\u1087 \uc0\u1090 \uc0\u1099  (\uc0\u1086 \uc0\u1073 \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1072 \uc0\u1085 \uc0\u1086  \uc0\u1073 \uc0\u1086 \uc0\u1083 \uc0\u1077 \uc0\u1077  13 800 \uc0\u1082 \uc0\u1077 \uc0\u1081 \uc0\u1089 \uc0\u1086 \uc0\u1074 ).{\line}\uc0\u8226  \uc0\u1048 \uc0\u1085 \uc0\u1085 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1080  \uc0\u1080  \uc0\u1076 \uc0\u1072 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1077 : \uc0\u1056 \uc0\u1072 \uc0\u1079 \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1072 \uc0\u1090 \uc0\u1099 \uc0\u1074 \uc0\u1072 \uc0\u1083  \uc0\u1080  \uc0\u1074 \uc0\u1085 \uc0\u1077 \uc0\u1076 \uc0\u1088 \uc0\u1103 \uc0\u1083  \uc0\u1089 \uc0\u1086 \uc0\u1074 \uc0\u1088 \uc0\u1077 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1077  \uc0\u1088 \uc0\u1077 \uc0\u1096 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1085 \uc0\u1072  \uc0\u1073 \uc0\u1072 \uc0\u1079 \uc0\u1077  LLM/RAG \uc0\u1076 \uc0\u1083 \uc0\u1103  \uc0\u1089 \uc0\u1077 \uc0\u1084 \uc0\u1072 \uc0\u1085 \uc0\u1090 \uc0\u1080 \uc0\u1095 \uc0\u1077 \uc0\u1089 \uc0\u1082 \uc0\u1086 \uc0\u1075 \uc0\u1086  \uc0\u1072 \uc0\u1085 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1079 \uc0\u1072  \uc0\u1076 \uc0\u1072 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1093  \uc0\u1080  \uc0\u1074 \uc0\u1099 \uc0\u1089 \uc0\u1090 \uc0\u1088 \uc0\u1072 \uc0\u1080 \uc0\u1074 \uc0\u1072 \uc0\u1083  \uc0\u1089 \uc0\u1082 \uc0\u1074 \uc0\u1086 \uc0\u1079 \uc0\u1085 \uc0\u1091 \uc0\u1102  \uc0\u1072 \uc0\u1085 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1090 \uc0\u1080 \uc0\u1082 \uc0\u1091  \uc0\u1074  Metabase (BI) \uc0\u1089  \uc0\u1082 \uc0\u1086 \uc0\u1085 \uc0\u1090 \uc0\u1088 \uc0\u1086 \uc0\u1083 \uc0\u1077 \uc0\u1084  SLA.{\line}\uc0\u1071  \uc0\u1091 \uc0\u1084 \uc0\u1077 \uc0\u1102  \uc0\u1090 \uc0\u1088 \uc0\u1072 \uc0\u1085 \uc0\u1089 \uc0\u1083 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1090 \uc0\u1100  \uc0\u1090 \uc0\u1088 \uc0\u1077 \uc0\u1073 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1073 \uc0\u1080 \uc0\u1079 \uc0\u1085 \uc0\u1077 \uc0\u1089 \uc0\u1072  \uc0\u1074  \uc0\u1087 \uc0\u1086 \uc0\u1085 \uc0\u1103 \uc0\u1090 \uc0\u1085 \uc0\u1099 \uc0\u1077  \uc0\u1090 \uc0\u1077 \uc0\u1093 \uc0\u1085 \uc0\u1080 \uc0\u1095 \uc0\u1077 \uc0\u1089 \uc0\u1082 \uc0\u1080 \uc0\u1077  \uc0\u1072 \uc0\u1083 \uc0\u1075 \uc0\u1086 \uc0\u1088 \uc0\u1080 \uc0\u1090 \uc0\u1084 \uc0\u1099  \uc0\u1076 \uc0\u1083 \uc0\u1103  \uc0\u1088 \uc0\u1072 \uc0\u1079 \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1082 \uc0\u1080  \uc0\u1080  \uc0\u1087 \uc0\u1088 \uc0\u1080 \uc0\u1074 \uc0\u1099 \uc0\u1082  \uc0\u1072 \uc0\u1088 \uc0\u1075 \uc0\u1091 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1090 \uc0\u1100  \uc0\u1088 \uc0\u1077 \uc0\u1096 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1084 \uc0\u1077 \uc0\u1090 \uc0\u1088 \uc0\u1080 \uc0\u1082 \uc0\u1072 \uc0\u1084 \uc0\u1080  \uc0\u1080  \uc0\u1094 \uc0\u1080 \uc0\u1092 \uc0\u1088 \uc0\u1072 \uc0\u1084 \uc0\u1080 .{\line}\uc0\u1041 \uc0\u1091 \uc0\u1076 \uc0\u1091  \uc0\u1088 \uc0\u1072 \uc0\u1076  \uc0\u1086 \uc0\u1073 \uc0\u1089 \uc0\u1091 \uc0\u1076 \uc0\u1080 \uc0\u1090 \uc0\u1100  \uc0\u1085 \uc0\u1072  \uc0\u1080 \uc0\u1085 \uc0\u1090 \uc0\u1077 \uc0\u1088 \uc0\u1074 \uc0\u1100 \uc0\u1102 , \uc0\u1082 \uc0\u1072 \uc0\u1082  \uc0\u1084 \uc0\u1086 \uc0\u1080  \uc0\u1085 \uc0\u1072 \uc0\u1074 \uc0\u1099 \uc0\u1082 \uc0\u1080  \uc0\u1072 \uc0\u1074 \uc0\u1090 \uc0\u1086 \uc0\u1084 \uc0\u1072 \uc0\u1090 \uc0\u1080 \uc0\u1079 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1080  \uc0\u1080  \uc0\u1091 \uc0\u1087 \uc0\u1088 \uc0\u1072 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1094 \uc0\u1077 \uc0\u1089 \uc0\u1089 \uc0\u1072 \uc0\u1084 \uc0\u1080  \uc0\u1087 \uc0\u1086 \uc0\u1084 \uc0\u1086 \uc0\u1075 \uc0\u1091 \uc0\u1090  \uc0\u1088 \uc0\u1077 \uc0\u1096 \uc0\u1080 \uc0\u1090 \uc0\u1100  \uc0\u1079 \uc0\u1072 \uc0\u1076 \uc0\u1072 \uc0\u1095 \uc0\u1080  \uc0\u1074 \uc0\u1072 \uc0\u1096 \uc0\u1077 \uc0\u1081  \uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1087 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1080 . \uc0\u1052 \uc0\u1086 \uc0\u1077  \uc0\u1088 \uc0\u1077 \uc0\u1079 \uc0\u1102 \uc0\u1084 \uc0\u1077  \uc0\u1089 \uc0\u1086  \uc0\u1074 \uc0\u1089 \uc0\u1077 \uc0\u1084 \uc0\u1080  \uc0\u1076 \uc0\u1077 \uc0\u1090 \uc0\u1072 \uc0\u1083 \uc0\u1103 \uc0\u1084 \uc0\u1080  \uc0\u1087 \uc0\u1088 \uc0\u1080 \uc0\u1082 \uc0\u1088 \uc0\u1077 \uc0\u1087 \uc0\u1083 \uc0\u1077 \uc0