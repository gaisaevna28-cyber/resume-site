\pard\intbl\itap1\sb250\sl260{\fs18 Fullstack-\uc0\u1072 \uc0\u1085 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1090 \uc0\u1080 \uc0\u1082  / Project Manager \uc0\u1089  4+ \uc0\u1075 \uc0\u1086 \uc0\u1076 \uc0\u1072 \uc0\u1084 \uc0\u1080  \uc0\u1086 \uc0\u1087 \uc0\u1099 \uc0\u1090 \uc0\u1072 . \uc0\u1041 \uc0\u1077 \uc0\u1088 \uc0\u1091  \uc0\u1079 \uc0\u1072 \uc0\u1076 \uc0\u1072 \uc0\u1095 \uc0\u1091  \uc0\u1086 \uc0\u1090  \uc0\u1074 \uc0\u1099 \uc0\u1103 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1073 \uc0\u1083 \uc0\u1077 \uc0\u1084 \uc0\u1099  \uc0\u1080  \uc0\u1086 \uc0\u1073 \uc0\u1097 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1089  \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1100 \uc0\u1079 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1090 \uc0\u1077 \uc0\u1083 \uc0\u1103 \uc0\u1084 \uc0\u1080  \uc0\u1076 \uc0\u1086  \uc0\u1090 \uc0\u1088 \uc0\u1077 \uc0\u1073 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1081 , \uc0\u1088 \uc0\u1072 \uc0\u1079 \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1082 \uc0\u1080 , \uc0\u1090 \uc0\u1077 \uc0\u1089 \uc0\u1090 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1080  \uc0\u1074 \uc0\u1099 \uc0\u1093 \uc0\u1086 \uc0\u1076 \uc0\u1072  \uc0\u1088 \uc0\u1077 \uc0\u1096 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1074  production.{\line}\uc0\u1056 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1072 \uc0\u1083  \uc0\u1089  B2B/B2G-\uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1076 \uc0\u1091 \uc0\u1082 \uc0\u1090 \uc0\u1072 \uc0\u1084 \uc0\u1080 , \uc0\u1075 \uc0\u1086 \uc0\u1089 \uc0\u1091 \uc0\u1076 \uc0\u1072 \uc0\u1088 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1077 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1084 \uc0\u1080  \uc0\u1080  \uc0\u1082 \uc0\u1086 \uc0\u1088 \uc0\u1087 \uc0\u1086 \uc0\u1088 \uc0\u1072 \uc0\u1090 \uc0\u1080 \uc0\u1074 \uc0\u1085 \uc0\u1099 \uc0\u1084 \uc0\u1080  \uc0\u1079 \uc0\u1072 \uc0\u1082 \uc0\u1072 \uc0\u1079 \uc0\u1095 \uc0\u1080 \uc0\u1082 \uc0\u1072 \uc0\u1084 \uc0\u1080 , e-commerce, AI \uc0\u1080  \uc0\u1084 \uc0\u1086 \uc0\u1073 \uc0\u1080 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1099 \uc0\u1084 \uc0\u1080  \uc0\u1087 \uc0\u1088 \uc0\u1080 \uc0\u1083 \uc0\u1086 \uc0\u1078 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103 \uc0\u1084 \uc0\u1080 . \uc0\u1045 \uc0\u1089 \uc0\u1090 \uc0\u1100  \uc0\u1087 \uc0\u1088 \uc0\u1072 \uc0\u1082 \uc0\u1090 \uc0\u1080 \uc0\u1095 \uc0\u1077 \uc0\u1089 \uc0\u1082 \uc0\u1080 \uc0\u1081  \uc0\u1086 \uc0\u1087 \uc0\u1099 \uc0\u1090  BPMN/UML, REST API, Kafka, Swagger/Postman, SQL, MySQL/PostgreSQL, Jira, Figma, A/B-\uc0\u1090 \uc0\u1077 \uc0\u1089 \uc0\u1090 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1080  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1076 \uc0\u1091 \uc0\u1082 \uc0\u1090 \uc0\u1086 \uc0\u1074 \uc0\u1086 \uc0\u1081  \uc0\u1072 \uc0\u1085 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1090 \uc0\u1080 \uc0\u1082 \uc0\u1080 .{\line}\uc0\u1053 \uc0\u1077  \uc0\u1086 \uc0\u1075 \uc0\u1088 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1095 \uc0\u1080 \uc0\u1074 \uc0\u1072 \uc0\u1102 \uc0\u1089 \uc0\u1100  \uc0\u1074 \uc0\u1093 \uc0\u1086 \uc0\u1076 \uc0\u1103 \uc0\u1097 \uc0\u1080 \uc0\u1084 \uc0\u1080  \uc0\u1079 \uc0\u1072 \uc0\u1076 \uc0\u1072 \uc0\u1095 \uc0\u1072 \uc0\u1084 \uc0\u1080 : \uc0\u1080 \uc0\u1089 \uc0\u1089 \uc0\u1083 \uc0\u1077 \uc0\u1076 \uc0\u1091 \uc0\u1102  \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1100 \uc0\u1079 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1090 \uc0\u1077 \uc0\u1083 \uc0\u1077 \uc0\u1081  \uc0\u1080  \uc0\u1082 \uc0\u1086 \uc0\u1085 \uc0\u1082 \uc0\u1091 \uc0\u1088 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1086 \uc0\u1074 , \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1077 \uc0\u1088 \uc0\u1103 \uc0\u1102  \uc0\u1080 \uc0\u1076 \uc0\u1077 \uc0\u1080  \uc0\u1076 \uc0\u1072 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1084 \uc0\u1080 , \uc0\u1087 \uc0\u1088 \uc0\u1077 \uc0\u1076 \uc0\u1083 \uc0\u1072 \uc0\u1075 \uc0\u1072 \uc0\u1102  \uc0\u1089 \uc0\u1086 \uc0\u1073 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1077 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1077  \uc0\u1088 \uc0\u1077 \uc0\u1096 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1080  \uc0\u1079 \uc0\u1072 \uc0\u1097 \uc0\u1080 \uc0\u1097 \uc0\u1072 \uc0\u1102  \uc0\u1080 \uc0\u1093  \uc0\u1087 \uc0\u1077 \uc0\u1088 \uc0\u1077 \uc0\u1076  \uc0\u1089 \uc0\u1090 \uc0\u1077 \uc0\u1081 \uc0\u1082 \uc0\u1093 \uc0\u1086 \uc0\u1083 \uc0\u1076 \uc0\u1077 \uc0\u1088 \uc0\u1072 \uc0\u1084 \uc0\u1080 . \uc0\u1054 \uc0\u1076 \uc0\u1080 \uc0\u1085  \uc0\u1080 \uc0\u1079  \uc0\u1090 \uc0\u1072 \uc0\u1082 \uc0\u1080 \uc0\u1093  \uc0\u1082 \uc0\u1077 \uc0\u1081 \uc0\u1089 \uc0\u1086 \uc0\u1074  \uc0\u8212  \uc0\u1080 \uc0\u1085 \uc0\u1080 \uc0\u1094 \uc0\u1080 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1081  AI-\uc0\u1092 \uc0\u1091 \uc0\u1085 \uc0\u1082 \uc0\u1094 \uc0\u1080 \uc0\u1086 \uc0\u1085 \uc0\u1072 \uc0\u1083  Omarket, \uc0\u1089 \uc0\u1086 \uc0\u1082 \uc0\u1088 \uc0\u1072 \uc0\u1090 \uc0\u1080 \uc0\u1074 \uc0\u1096 \uc0\u1080 \uc0\u1081  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1094 \uc0\u1077 \uc0\u1089 \uc0\u1089  \uc0\u1079 \uc0\u1072 \uc0\u1075 \uc0\u1088 \uc0\u1091 \uc0\u1079 \uc0\u1082 \uc0\u1080  \uc0\u1085 \uc0\u1086 \uc0\u1074 \uc0\u1086 \uc0\u1075 \uc0\u1086  \uc0\u1090 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1088 \uc0\u1072  \uc0\u1074  \uc0\u1082 \uc0\u1072 \uc0\u1090 \uc0\u1072 \uc0\u1083 \uc0\u1086 \uc0\u1075  \uc0\u1087 \uc0\u1088 \uc0\u1080 \uc0\u1084 \uc0\u1077 \uc0\u1088 \uc0\u1085 \uc0\u1086  \uc0\u1089  30 \uc0\u1076 \uc0\u1086  3\uc0\u8211 5 \uc0\u1084 \uc0\u1080 \uc0\u1085 \uc0\u1091 \uc0\u1090 .{\line}\uc0\u1050 \uc0\u1086 \uc0\u1084 \uc0\u1092 \uc0\u1086 \uc0\u1088 \uc0\u1090 \uc0\u1085 \uc0\u1086  \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1072 \uc0\u1102  \uc0\u1085 \uc0\u1072  \uc0\u1089 \uc0\u1090 \uc0\u1099 \uc0\u1082 \uc0\u1077  \uc0\u1073 \uc0\u1080 \uc0\u1079 \uc0\u1085 \uc0\u1077 \uc0\u1089 \uc0\u1072 , \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1100 \uc0\u1079 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1090 \uc0\u1077 \uc0\u1083 \uc0\u1077 \uc0\u1081 , \uc0\u1088 \uc0\u1072 \uc0\u1079 \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1082 \uc0\u1080 , QA, DevOps \uc0\u1080  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1076 \uc0\u1091 \uc0\u1082 \uc0\u1090 \uc0\u1072 . \uc0\u1055 \uc0\u1088 \uc0\u1077 \uc0\u1076 \uc0\u1087 \uc0\u1086 \uc0\u1095 \uc0\u1080 \uc0\u1090 \uc0\u1072 \uc0\u1102  \uc0\u1086 \uc0\u1090 \uc0\u1074 \uc0\u1077 \uc0\u1095 \uc0\u1072 \uc0\u1090 \uc0\u1100  \uc0\u1085 \uc0\u1077  \uc0\u1090 \uc0\u1086 \uc0\u1083 \uc0\u1100 \uc0\u1082 \uc0\u1086  \uc0\u1079 \uc0\u1072  \uc0\u1087 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1072 \uc0\u1085 \uc0\u1086 \uc0\u1074 \uc0\u1082 \uc0\u1091  \uc0\u1079 \uc0\u1072 \uc0\u1076 \uc0\u1072 \uc0\u1095 \uc0\u1080 , \uc0\u1085 \uc0\u1086  \uc0\u1080  \uc0\u1079 \uc0\u1072  \uc0\u1082 \uc0\u1086 \uc0\u1085 \uc0\u1077 \uc0\u1095 \uc0\u1085 \uc0\u1099 \uc0\u1081  \uc0\u1088 \uc0\u1077 \uc0\u1079 \uc0\u1091 \uc0\u1083 \uc0\u1100 \uc0\u1090 \uc0\u1072 \uc0\u1090 !{\line}-----------------{\line}\uc0\u1055 \uc0\u1086 \uc0\u1084 \uc0\u1080 \uc0\u1084 \uc0\u1086  \uc0\u1086 \uc0\u1089 \uc0\u1085 \uc0\u1086 \uc0\u1074 \uc0\u1085 \uc0\u1086 \uc0\u1081  \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1099  \uc0\u1088 \uc0\u1077 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1079 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1083  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1099 :{\line}1. \uc0\u1052 \uc0\u1086 \uc0\u1073 \uc0\u1080 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1099 \uc0\u1077  \uc0\u1087 \uc0\u1088 \uc0\u1080 \uc0\u1083 \uc0\u1086 \uc0\u1078 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103  + \uc0\u1089 \uc0\u1072 \uc0\u1081 \uc0\u1090 \uc0\u1099  \uc0\u1074  \uc0\u1089 \uc0\u1092 \uc0\u1077 \uc0\u1088 \uc0\u1077  \uc0\u1089 \uc0\u1087 \uc0\u1086 \uc0\u1088 \uc0\u1090 \uc0\u1072 (\uc0\u1084 \uc0\u1080 \uc0\u1085 \uc0\u1080 -\uc0\u1092 \uc0\u1091 \uc0\u1090 \uc0\u1073 \uc0\u1086 \uc0\u1083 ), \uc0\u1082 \uc0\u1086 \uc0\u1090 \uc0\u1086 \uc0\u1088 \uc0\u1099 \uc0\u1084 \uc0\u1080  \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1100 \uc0\u1079 \uc0\u1091 \uc0\u1102 \uc0\u1090 \uc0\u1089 \uc0\u1103  \uc0\u1087 \uc0\u1086  \uc0\u1074 \uc0\u1089 \uc0\u1077 \uc0\u1081  \uc0\u1089 \uc0\u1090 \uc0\u1088 \uc0\u1072 \uc0\u1085 \uc0\u1077  (AFL Socca Kazakhstan(https://afl.kz/) , Minifootball (https://kmff.kz)) {\line}2. \uc0\u1055 \uc0\u1088 \uc0\u1080 \uc0\u1083 \uc0\u1086 \uc0\u1078 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  Aither (https://aitherltd.kz/support) - \uc0\u1091 \uc0\u1084 \uc0\u1085 \uc0\u1099 \uc0\u1081  \uc0\u1087 \uc0\u1086 \uc0\u1080 \uc0\u1089 \uc0\u1082  \uc0\u1082 \uc0\u1074 \uc0\u1072 \uc0\u1088 \uc0\u1090 \uc0\u1080 \uc0\u1088  \uc0\u1085 \uc0\u1072  \uc0\u1086 \uc0\u1089 \uc0\u1085 \uc0\u1086 \uc0\u1074 \uc0\u1077  AI - \uc0\u1091 \uc0\u1089 \uc0\u1087 \uc0\u1077 \uc0\u1096 \uc0\u1085 \uc0\u1086 \uc0\u1077  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1077 \uc0\u1082 \uc0\u1090  \uc0\u1074  \uc0\u1089 \uc0\u1092 \uc0\u1077 \uc0\u1088 \uc0\u1077   \uc0\u1072 \uc0\u1088 \uc0\u1077 \uc0\u1085 \uc0\u1076 \uc0\u1099  \uc0\u1085 \uc0\u1077 \uc0\u1076 \uc0\u1074 \uc0\u1080 \uc0\u1078 \uc0\u1080 \uc0\u1084 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1080 , \uc0\u1082 \uc0\u1086 \uc0\u1090 \uc0\u1086 \uc0\u1088 \uc0\u1099 \uc0\u1081  \uc0\u1091 \uc0\u1078 \uc0\u1077  \uc0\u1074 \uc0\u1099 \uc0\u1093 \uc0\u1086 \uc0\u1076 \uc0\u1080 \uc0\u1090  \uc0\u1085 \uc0\u1072  \uc0\u1088 \uc0\u1099 \uc0\u1085 \uc0\u1082 \uc0\u1080  \uc0\u1076 \uc0\u1088 \uc0\u1091 \uc0\u1075 \uc0\u1080 \uc0\u1093  \uc0\u1089 \uc0\u1090 \uc0\u1088 \uc0\u1072 \uc0\u1085  \uc0\u1080  \uc0\u1072 \uc0\u1082 \uc0\u1090 \uc0\u1080 \uc0\u1074 \uc0\u1085 \uc0\u1086  \uc0\u1087 \uc0\u1088 \uc0\u1080 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1103 \uc0\u1077 \uc0\u1090 \uc0\u1089 \uc0\u1103  \uc0\u1074  \uc0\u1040 \uc0\u1089 \uc0\u1090 \uc0\u1072 \uc0\u1085 \uc0\u1077 , \uc0\u1040 \uc0\u1083 \uc0\u1084 \uc0\u1072 \uc0\u1090 \uc0\u1099  \uc0\u1080  \uc0\u1064 \uc0\u1099 \uc0\u1084 \uc0\u1082 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1077 .}\cell\row


\trowd\cellx9638\pard\intbl\itap1\sa150\sb500\brdrb\brdrs\brdrcf2{\fs22\cf1 \uc0\u1048 \uc0\u1089 \uc0\u1090 \uc0\u1086 \uc0\u1088 \uc0\u1080 \uc0\u1103  \uc0\u1086 \uc0\u1073 \uc0\u1097 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1089  \uc0\u1082 \uc0\u1072 \uc0\u1085 \uc0\u1076 \uc0\u1080 \uc0\u1076 \uc0\u1072 \uc0\u1090 \uc0\u1086 \uc0\u1084 }\cell\row


