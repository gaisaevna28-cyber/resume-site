\pard\intbl\itap1\sl260{\fs18
{\cb5\chcfpat5\chcbpat5 \uc0\u1056 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1086 \uc0\u1089 \uc0\u1087 \uc0\u1086 \uc0\u1089 \uc0\u1086 \uc0\u1073 \uc0\u1085 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1100 }  {\cb5\chcfpat5\chcbpat5 Python}  {\cb5\chcfpat5\chcbpat5 SQL}  {\cb5\chcfpat5\chcbpat5 \uc0\u1056 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1072 \~\uc0\u1074 \~\uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1072 \uc0\u1085 \uc0\u1076 \uc0\u1077 }  {\cb5\chcfpat5\chcbpat5 \uc0\u1056 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1072 \~\uc0\u1089 \~\uc0\u1073 \uc0\u1086 \uc0\u1083 \uc0\u1100 \uc0\u1096 \uc0\u1080 \uc0\u1084 \~\uc0\u1086 \uc0\u1073 \uc0\u1098 \uc0\u1077 \uc0\u1084 \uc0\u1086 \uc0\u1084 \~\uc0\u1080 \uc0\u1085 \uc0\u1092 \uc0\u1086 \uc0\u1088 \uc0\u1084 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1080 }  {\cb5\chcfpat5\chcbpat5 \uc0\u1054 \uc0\u1088 \uc0\u1075 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1079 \uc0\u1072 \uc0\u1090 \uc0\u1086 \uc0\u1088 \uc0\u1089 \uc0\u1082 \uc0\u1080 \uc0\u1077 \~\uc0\u1085 \uc0\u1072 \uc0\u1074 \uc0\u1099 \uc0\u1082 \uc0\u1080 }  {\cb5\chcfpat5\chcbpat5 Helpdesk}  {\cb5\chcfpat5\chcbpat5 \uc0\u1055 \uc0\u1086 \uc0\u1083 \uc0\u1100 \uc0\u1079 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1090 \uc0\u1077 \uc0\u1083 \uc0\u1100 \~\uc0\u1055 \uc0\u1050 }  {\cb5\chcfpat5\chcbpat5 \uc0\u1040 \uc0\u1085 \uc0\u1075 \uc0\u1083 \uc0\u1080 \uc0\u1081 \uc0\u1089 \uc0\u1082 \uc0\u1080 \uc0\u1081 \~\uc0\u1103 \uc0\u1079 \uc0\u1099 \uc0\u1082 }  {\cb5\chcfpat5\chcbpat5 \uc0\u1059 \uc0\u1087 \uc0\u1088 \uc0\u1072 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077 \~\uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1072 \uc0\u1084 \uc0\u1080 }  {\cb5\chcfpat5\chcbpat5 Atlassian\~Jira}  {\cb5\chcfpat5\chcbpat5 Figma}  {\cb5\chcfpat5\chcbpat5 Agile\~Project\~Management}  {\cb5\chcfpat5\chcbpat5 \uc0\u1053 \uc0\u1072 \uc0\u1087 \uc0\u1080 \uc0\u1089 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1077 \~\uc0\u1058 \uc0\u1047 }  {\cb5\chcfpat5\chcbpat5 Scrum}  {\cb5\chcfpat5\chcbpat5 Agile}  {\cb5\chcfpat5\chcbpat5 \uc0\u1055 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1072 \uc0\u1085 \uc0\u1086 \uc0\u1074 \uc0\u1082 \uc0\u1072 \~\uc0\u1079 \uc0\u1072 \uc0\u1076 \uc0\u1072 \uc0\u1095 \~\uc0\u1088 \uc0\u1072 \uc0\u1079 \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1095 \uc0\u1080 \uc0\u1082 \uc0\u1072 \uc0\u1084 }  {\cb5\chcfpat5\chcbpat5 \uc0\u1055 \uc0\u1088 \uc0\u1086 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1085 \uc0\u1072 \uc0\u1103 \~\uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1072 }  {\cb5\chcfpat5\chcbpat5 \uc0\u1053 \uc0\u1072 \uc0\u1074 \uc0\u1099 \uc0\u1082 \uc0\u1080 \~\uc0\u1087 \uc0\u1088 \uc0\u1077 \uc0\u1079 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1080 }  {\cb5\chcfpat5\chcbpat5 \uc0\u1058 \uc0\u1077 \uc0\u1089 \uc0\u1090 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1077 \~\uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1100 \uc0\u1079 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1090 \uc0\u1077 \uc0\u1083 \uc0\u1100 \uc0\u1089 \uc0\u1082 \uc0\u1086 \uc0\u1075 \uc0\u1086 \~\uc0\u1080 \uc0\u1085 \uc0\u1090 \uc0\u1077 \uc0\u1088 \uc0\u1092 \uc0\u1077 \uc0\u1081 \uc0\u1089 \uc0\u1072 }  {\cb5\chcfpat5\chcbpat5 Claude}  {\cb5\chcfpat5\chcbpat5 ChatGPT}  {\cb5\chcfpat5\chcbpat5 Qwen}  {\cb5\chcfpat5\chcbpat5 \uc0\u1055 \uc0\u1088 \uc0\u1080 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077 \~\uc0\u1048 \uc0\u1048 \~\uc0\u1076 \uc0\u1083 \uc0\u1103 \~\uc0\u1088 \uc0\u1091 \uc0\u1090 \uc0\u1080 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1093 \~\uc0\u1079 \uc0\u1072 \uc0\u1076 \uc0\u1072 \uc0\u1095 }}\cell\row

