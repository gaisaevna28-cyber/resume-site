{\fs18 \uc0\u8226  \uc0\u1050 \uc0\u1086 \uc0\u1083 \uc0\u1083 -\uc0\u1094 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1088 \uc0\u1099 , \uc0\u1076 \uc0\u1080 \uc0\u1089 \uc0\u1087 \uc0\u1077 \uc0\u1090 \uc0\u1095 \uc0\u1077 \uc0\u1088 \uc0\u1089 \uc0\u1082 \uc0\u1080 \uc0\u1077  \uc0\u1089 \uc0\u1083 \uc0\u1091 \uc0\u1078 \uc0\u1073 \uc0\u1099 }
}
