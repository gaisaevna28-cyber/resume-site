\trowd\cellx1800\cellx9638\pard\intbl\itap1\sb250\sl220{\fs16\cf3 \uc0\u1053 \uc0\u1072 \uc0\u1074 \uc0\u1099 \uc0\u1082 \uc0\u1080 }\cell
\pard\intbl\itap1\sl260{\fs18
{\cb5\chcfpat5\chcbpat5 Figma\~(UI/UX\~\uc0\u1076 \uc0\u1080 \uc0\u1079 \uc0\u1072 \uc0\u1081 \uc0\u1085 )}  {\cb5\chcfpat5\chcbpat5 \uc0\u1080 \uc0\u1085 \uc0\u1090 \uc0\u1077 \uc0\u1075 \uc0\u1088 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1103 \~API}  {\cb5\chcfpat5\chcbpat5 PHPMailer}  {\cb5\chcfpat5\chcbpat5 SMTP-\uc0\u1072 \uc0\u1074 \uc0\u1090 \uc0\u1086 \uc0\u1088 \uc0\u1080 \uc0\u1079 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1103 }  {\cb5\chcfpat5\chcbpat5 \uc0\u1073 \uc0\u1077 \uc0\u1079 \uc0\u1086 \uc0\u1087 \uc0\u1072 \uc0\u1089 \uc0\u1085 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1100 \~\uc0\u1074 \uc0\u1077 \uc0\u1073 -\uc0\u1092 \uc0\u1086 \uc0\u1088 \uc0\u1084 }  {\cb5\chcfpat5\chcbpat5 \uc0\u1040 \uc0\u1076 \uc0\u1084 \uc0\u1080 \uc0\u1085 \uc0\u1080 \uc0\u1089 \uc0\u1090 \uc0\u1088 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1077 \~\uc0\u1074 \uc0\u1077 \uc0\u1073 -\uc0\u1089 \uc0\u1077 \uc0\u1088 \uc0\u1074 \uc0\u1077 \uc0\u1088 \uc0\u1086 \uc0\u1074 }  {\cb5\chcfpat5\chcbpat5 \uc0\u1087 \uc0\u1072 \uc0\u1085 \uc0\u1077 \uc0\u1083 \uc0\u1100 \~Plesk}  {\cb5\chcfpat5\chcbpat5 Linux}  {\cb5\chcfpat5\chcbpat5 \uc0\u1091 \uc0\u1087 \uc0\u1088 \uc0\u1072 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077 \~DNS}  {\cb5\chcfpat5\chcbpat5 \uc0\u1076 \uc0\u1086 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1099 }  {\cb5\chcfpat5\chcbpat5 SSL/HTTPS}  {\cb5\chcfpat5\chcbpat5 UI/UX\~\uc0\u1088 \uc0\u1091 \uc0\u1095 \uc0\u1085 \uc0\u1086 \uc0\u1077 \~\uc0\u1090 \uc0\u1077 \uc0\u1089 \uc0\u1090 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1077 \~(\uc0\u1087 \uc0\u1086 \uc0\u1079 \uc0\u1080 \uc0\u1090 \uc0\u1080 \uc0\u1074 \uc0\u1085 \uc0\u1086 \uc0\u1077 /\uc0\u1085 \uc0\u1077 \uc0\u1075 \uc0\u1072 \uc0\u1090 \uc0\u1080 \uc0\u1074 \uc0\u1085 \uc0\u1086 \uc0\u1077 )}  {\cb5\chcfpat5\chcbpat5 DevTools}  {\cb5\chcfpat5\chcbpat5 \uc0\u1074 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1076 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1103 \~\uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1077 \uc0\u1081 }  {\cb5\chcfpat5\chcbpat5 Atlassian\~Jira}  {\cb5\chcfpat5\chcbpat5 Thunderbird}  {\cb5\chcfpat5\chcbpat5 \uc0\u1040 \uc0\u1085 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1090 \uc0\u1080 \uc0\u1095 \uc0\u1077 \uc0\u1089 \uc0\u1082 \uc0\u1080 \uc0\u1081 \~\uc0\u1089 \uc0\u1082 \uc0\u1083 \uc0\u1072 \uc0\u1076 \~\uc0\u1091 \uc0\u1084 \uc0\u1072 \~(\uc0\u1087 \uc0\u1088 \uc0\u1080 \uc0\u1079 \uc0\u1077 \uc0\u1088 \~\uc0\u1092 \uc0\u1080 \uc0\u1079 -\uc0\u1084 \uc0\u1072 \uc0\u1090 \~\uc0\u1086 \uc0\u1083 \uc0\u1080 \uc0\u1084 \uc0\u1087 \uc0\u1080 \uc0\u1072 \uc0\u1076 )}  {\cb5\chcfpat5\chcbpat5 \uc0\u1059 \uc0\u1087 \uc0\u1088 \uc0\u1072 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077 \~\uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1072 \uc0\u1084 \uc0\u1080 }  {\cb5\chcfpat5\chcbpat5 React}  {\cb5\chcfpat5\chcbpat5 Node.js}  {\cb5\chcfpat5\chcbpat5 JavaScript}  {\cb5\chcfpat5\chcbpat5 MySQL}  {\cb5\chcfpat5\chcbpat5 HTML5}  {\cb5\chcfpat5\chcbpat5 PHP}  {\cb5\chcfpat5\chcbpat5 Git}  {\cb5\chcfpat5\chcbpat5 \uc0\u1056 \uc0\u1072 \uc0\u1079 \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1082 \uc0\u1072 \~\uc0\u1055 \uc0\u1054 }  {\cb5\chcfpat5\chcbpat5 \uc0\u1054 \uc0\u1073 \uc0\u1091 \uc0\u1095 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077 \~\uc0\u1087 \uc0\u1077 \uc0\u1088 \uc0\u1089 \uc0\u1086 \uc0\u1085 \uc0\u1072 \uc0\u1083 \uc0\u1072 }  {\cb5\chcfpat5\chcbpat5 AI-\uc0\u1072 \uc0\u1075 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1099 }  {\cb5\chcfpat5\chcbpat5 \uc0\u1048 \uc0\u1048 -\uc0\u1089 \uc0\u1086 \uc0\u1090 \uc0\u1088 \uc0\u1091 \uc0\u1076 \uc0\u1085 \uc0\u1080 \uc0\u1082 \uc0\u1080 }}\cell\row

\trowd\cellx9638\pard\intbl\itap1\sa150\sb500\brdrb\brdrs\brdrcf2{\fs22\cf1 \uc0\u1054 \uc0\u1087 \uc0\u1099 \uc0\u1090  \uc0\u1074 \uc0\u1086 \uc0\u1078 \uc0\u1076 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103 }\cell\row

\trowd\cellx9638\pard\intbl\itap1\sa100\sl280{\fs18
\uc0\u1048 \uc0\u1084 \uc0\u1077 \uc0\u1077 \uc0\u1090 \uc0\u1089 \uc0\u1103  \uc0\u1089 \uc0\u1086 \uc0\u1073 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1077 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1081  \uc0\u1072 \uc0\u1074 \uc0\u1090 \uc0\u1086 \uc0\u1084 \uc0\u1086 \uc0\u1073 \uc0\u1080 \uc0\u1083 \uc0\u1100 \par
\uc0\u1055 \uc0\u1088 \uc0\u1072 \uc0\u1074 \uc0\u1072  \uc0\u1082 \uc0\u1072 \uc0\u1090 \uc0\u1077 \uc0\u1075 \uc0\u1086 \uc0\u1088 \uc0\u1080 \uc0\u1080  B
}\cell\row
\trowd\cellx9638\pard\intbl\itap1\sa150\sb500\brdrb\brdrs\brdrcf2{\fs22\cf1 \uc0\u1044 \uc0\u1086 \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1085 \uc0\u1080 \uc0\u1090 \uc0\u1077 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1072 \uc0\u1103  \uc0\u1080 \uc0\u1085 \uc0\u1092 \uc0\u1086 \uc0\u1088 \uc0\u1084 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1103 }\cell\row

\trowd\cellx1800\cellx9638\pard\intbl\itap1\sl220{\fs16\cf3 \uc0\u1056 \uc0\u1077 \uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1076 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1080 }\cell
\pard\intbl\itap1\sl260{\fs18
\uc0\u1056 \uc0\u1043 \uc0\u1055  \uc0\u1085 \uc0\u1072  \uc0\u1055 \uc0\u1061 \uc0\u1042  "\uc0\u1050 \uc0\u1072 \uc0\u1079 \uc0\u1075 \uc0\u1080 \uc0\u1076 \uc0\u1088 \uc0\u1086 \uc0\u1084 \uc0\u1077 \uc0\u1090 " \uc0\u1052 \uc0\u1080 \uc0\u1085 \uc0\u1080 \uc0\u1089 \uc0\u1090 \uc0\u1077 \uc0\u1088 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1072  \uc0\u1069 \uc0\u1085 \uc0\u1077 \uc0\u1088 \uc0\u1075 \uc0\u1077 \uc0\u1090 \uc0\u1080 \uc0\u1082 \uc0\u1080  \uc0\u1056 \uc0\u1050 \par
{\cf1 \uc0\u1041 \uc0\u1072 \uc0\u1093 \uc0\u1099 \uc0\u1090 \uc0\u1078 \uc0\u1072 \uc0\u1085  \uc0\u1057 \uc0\u1072 \uc0\u1081 \uc0\u1083 \uc0\u1099 \uc0\u1073 \uc0\u1072 \uc0\u1077 \uc0\u1074  (\uc0\u1044 \uc0\u1080 \uc0\u1088 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1086 \uc0\u1088  \uc0\u1044 \uc0\u1077 \uc0\u1087 \uc0\u1072 \uc0\u1088 \uc0\u1090 \uc0\u1072 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1072  \uc0\u1080 \uc0\u1085 \uc0\u1092 \uc0\u1086 \uc0\u1088 \uc0\u1084 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1086 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1093  \uc0\u1089 \uc0\u1080 \uc0\u1089 \uc0\u1090 \uc0\u1077 \uc0\u1084 )}
\par\par \uc0\u1056 \uc0\u1043 \uc0\u1055  \uc0\u1085 \uc0\u1072  \uc0\u1055 \uc0\u1061 \uc0\u1042  "\uc0\u1050 \uc0\u1072 \uc0\u1079 \uc0\u1075 \uc0\u1080 \uc0\u1076 \uc0\u1088 \uc0\u1086 \uc0\u1084 \uc0\u1077 \uc0\u1090 " \uc0\u1052 \uc0\u1080 \uc0\u1085 \uc0\u1080 \uc0\u1089 \uc0\u1090 \uc0\u1077 \uc0\u1088 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1072  \uc0\u1069 \uc0\u1085 \uc0\u1077 \uc0\u1088 \uc0\u1075 \uc0\u1077 \uc0\u1090 \uc0\u1080 \uc0\u1082 \uc0\u1080  \uc0\u1056 \uc0\u1050 \par
{\cf1 \uc0\u1058 \uc0\u1091 \uc0\u1083 \uc0\u1077 \uc0\u1073 \uc0\u1072 \uc0\u1077 \uc0\u1074 \uc0\u1072  \uc0\u1043 \uc0\u1091 \uc0\u1083 \uc0\u1100 \uc0\u1078 \uc0\u1072 \uc0\u1085  \uc0\u1052 \uc0\u1091 \uc0\u1088 \uc0\u1072 \uc0\u1090 \uc0\u1086 \uc0\u1074 \uc0\u1085 \uc0\u1072  (\uc0\u1044 \uc0\u1080 \uc0\u1088 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1086 \uc0\u1088  \uc0\u1044 \uc0\u1077 \uc0\u1087 \uc0\u1072 \uc0\u1088 \uc0\u1090 \uc0\u1072 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1072  \uc0\u1052 \uc0\u1077 \uc0\u1078 \uc0\u1076 \uc0\u1091 \uc0\u1085 \uc0\u1072 \uc0\u1088 \uc0\u1086 \uc0\u1076 \uc0\u1085 \uc0\u1086 \uc0\u1075 \uc0\u1086  \uc0\u1089 \uc0\u1086 \uc0\u1090 \uc0\u1088 \uc0\u1091 \uc0\u1076 \uc0\u1085 \uc0\u1080 \uc0\u1095 \uc0\u1077 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1072  \uc0\u1080  \uc0\u1052 \uc0\u1072 \uc0\u1088 \uc0\u1082 \uc0\u1077 \uc0\u1090 \uc0\u1080 \uc0\u1085 \uc0\u1075 \uc0\u1072  )}
}\cell\row

