\uc0\u1092 \uc0\u1080 \uc0\u1083 \uc0\u1080 \uc0\u1072 \uc0\u1083  "\uc0\u1040 \uc0\u1054  \uc0\u1053 \uc0\u1050  \uc0\u1050 \uc0\u1072 \uc0\u1079 \uc0\u1072 \uc0\u1093 \uc0\u1089 \uc0\u1090 \uc0\u1072 \uc0\u1085  \uc0\u1090 \uc0\u1077 \uc0\u1084 \uc0\u1080 \uc0\u1088  \uc0\u1078 \uc0\u1086 \uc0\u1083 \uc0\u1099 " \uc0\u1062 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1088  \uc0\u1076 \uc0\u1080 \uc0\u1072 \uc0\u1075 \uc0\u1085 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1080 \uc0\u1082 \uc0\u1080  \uc0\u1087 \uc0\u1091 \uc0\u1090 \uc0\u1080 .
